# Project C/C++ sources/headers and C# tools. CRLF matches .gitattributes.
root = true

[src/**.{c,cpp,h}]
charset = utf-8
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# C layout and mandatory braces are configured in .clang-format.

# TempleOS HolyC uses two-column nesting and compact expression spacing.
[src/**.{HC,HH}]
charset = utf-8
indent_style = space
indent_size = 2
tab_width = 8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.cs]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:error

[*.{csproj,slnx}]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = crlf
insert_final_newline = true
