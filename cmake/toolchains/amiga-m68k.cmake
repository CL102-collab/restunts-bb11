# AmigaOS 2.x / Motorola 68000, using the amiga-gcc SDK and libnix.
# Set AMIGA_TOOLCHAIN to the SDK prefix, or put m68k-amigaos-gcc in PATH.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR m68k)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(RESTUNTS_AMIGA ON CACHE BOOL "Build the native Amiga port" FORCE)

set(AMIGA_TOOLCHAIN "$ENV{AMIGA_TOOLCHAIN}" CACHE PATH "amiga-gcc SDK prefix")
find_program(CMAKE_C_COMPILER m68k-amigaos-gcc
    HINTS "${AMIGA_TOOLCHAIN}/bin" REQUIRED)
find_program(CMAKE_AR m68k-amigaos-ar
    HINTS "${AMIGA_TOOLCHAIN}/bin" REQUIRED)
find_program(CMAKE_RANLIB m68k-amigaos-ranlib
    HINTS "${AMIGA_TOOLCHAIN}/bin" REQUIRED)
set(CMAKE_C_FLAGS_INIT "-m68000 -noixemul")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-m68000 -noixemul")
set(CMAKE_EXECUTABLE_SUFFIX "")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
