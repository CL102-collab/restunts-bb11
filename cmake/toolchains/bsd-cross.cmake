# Build with native x64 BSD tools against a matching-release foreign CPU SDK.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    RESTUNTS_BSD_TARGET RESTUNTS_BSD_SYSROOT)
if(NOT RESTUNTS_BSD_SYSROOT OR NOT IS_ABSOLUTE "${RESTUNTS_BSD_SYSROOT}")
    message(FATAL_ERROR "RESTUNTS_BSD_SYSROOT must name an absolute prepared SDK path")
endif()
file(READ "${RESTUNTS_BSD_SYSROOT}/restunts-target" restunts_sdk_target)
string(STRIP "${restunts_sdk_target}" restunts_sdk_target)
if(NOT restunts_sdk_target STREQUAL RESTUNTS_BSD_TARGET)
    message(FATAL_ERROR "The BSD SDK does not match ${RESTUNTS_BSD_TARGET}")
endif()
set(restunts_bsd_cross_targets
    freebsd-x86 freebsd-armv7 freebsd-arm64 freebsd-riscv64
    openbsd-x86 openbsd-arm64 openbsd-riscv64
    netbsd-armv7 netbsd-arm64 netbsd-riscv64)
list(FIND restunts_bsd_cross_targets "${RESTUNTS_BSD_TARGET}" restunts_bsd_target_index)
if(restunts_bsd_target_index EQUAL -1)
    message(FATAL_ERROR "Unsupported BSD cross target: ${RESTUNTS_BSD_TARGET}")
endif()
string(REPLACE "-" ";" restunts_bsd_components "${RESTUNTS_BSD_TARGET}")
list(GET restunts_bsd_components 0 restunts_bsd_system)
list(GET restunts_bsd_components 1 restunts_bsd_arch)
if(restunts_bsd_arch STREQUAL "arm64")
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
elseif(restunts_bsd_arch STREQUAL "x86")
    set(CMAKE_SYSTEM_PROCESSOR i386)
elseif(restunts_bsd_arch STREQUAL "armv7")
    set(CMAKE_SYSTEM_PROCESSOR armv7)
else()
    set(CMAKE_SYSTEM_PROCESSOR riscv64)
endif()
if(restunts_bsd_system STREQUAL "freebsd")
    set(CMAKE_SYSTEM_NAME FreeBSD)
    if(restunts_bsd_arch STREQUAL "arm64")
        set(CMAKE_SYSTEM_VERSION 14.4)
    elseif(restunts_bsd_arch MATCHES "^(x86|armv7)$")
        set(CMAKE_SYSTEM_VERSION 14.5)
    else()
        set(CMAKE_SYSTEM_VERSION 15.0)
    endif()
    set(restunts_llvm_bin /usr/bin)
elseif(restunts_bsd_system STREQUAL "openbsd")
    set(CMAKE_SYSTEM_NAME OpenBSD)
    # OpenBSD's base compiler only includes its native CPU backend.
    # Ports wrappers also set the private LLVM runtime library search path.
    set(restunts_llvm_bin /usr/local/bin)
    if(restunts_bsd_arch STREQUAL "x86")
        set(CMAKE_SYSTEM_VERSION 8.0)
        set(restunts_openbsd_llvm_version 22)
    else()
        set(CMAKE_SYSTEM_VERSION 7.9)
        set(restunts_openbsd_llvm_version 19)
    endif()
else()
    set(CMAKE_SYSTEM_NAME NetBSD)
    if(restunts_bsd_arch MATCHES "^(arm64|armv7)$")
        set(CMAKE_SYSTEM_VERSION 10.2)
    else()
        set(CMAKE_SYSTEM_VERSION 11.0)
    endif()
    set(restunts_llvm_bin /usr/pkg/bin)
    # NetBSD's release sets provide GCC's C++ headers and runtime.
    set(restunts_netbsd_compat "${CMAKE_CURRENT_LIST_DIR}/netbsd-clang-compat.h")
    set(CMAKE_C_FLAGS_INIT "-include \"${restunts_netbsd_compat}\"")
    set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -stdlib=libstdc++")
    # Clang's NetBSD driver omits libgcc_s even when using GCC's C++ runtime.
    set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-lgcc_s")
endif()
set(restunts_c_compiler clang)
set(restunts_cxx_compiler clang++)
set(restunts_linker ld.lld)
if(CMAKE_SYSTEM_NAME STREQUAL "OpenBSD")
    set(restunts_c_compiler "clang-${restunts_openbsd_llvm_version}")
    set(restunts_cxx_compiler "clang++-${restunts_openbsd_llvm_version}")
    set(restunts_linker "ld.lld-${restunts_openbsd_llvm_version}")
endif()
find_program(CMAKE_C_COMPILER NAMES ${restunts_c_compiler} HINTS "${restunts_llvm_bin}"
    NO_DEFAULT_PATH REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES ${restunts_cxx_compiler} HINTS "${restunts_llvm_bin}"
    NO_DEFAULT_PATH REQUIRED)
find_program(CMAKE_LINKER NAMES ${restunts_linker} HINTS "${restunts_llvm_bin}"
    NO_DEFAULT_PATH REQUIRED)
# Native NetBSD binutils may only support the build host's object format.
set(restunts_archivers llvm-ar)
set(restunts_indexers llvm-ranlib)
if(CMAKE_SYSTEM_NAME STREQUAL "OpenBSD")
    set(restunts_archivers "llvm-ar-${restunts_openbsd_llvm_version}")
    set(restunts_indexers "llvm-ranlib-${restunts_openbsd_llvm_version}")
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
    # FreeBSD's base elftoolchain also supports foreign ELF architectures.
    list(APPEND restunts_archivers ar)
    list(APPEND restunts_indexers ranlib)
endif()
find_program(CMAKE_AR NAMES ${restunts_archivers} HINTS "${restunts_llvm_bin}"
    NO_DEFAULT_PATH REQUIRED)
find_program(CMAKE_RANLIB NAMES ${restunts_indexers} HINTS "${restunts_llvm_bin}"
    NO_DEFAULT_PATH REQUIRED)
set(restunts_bsd_triple
    "${CMAKE_SYSTEM_PROCESSOR}-unknown-${restunts_bsd_system}${CMAKE_SYSTEM_VERSION}")
if(restunts_bsd_arch STREQUAL "armv7")
    string(APPEND restunts_bsd_triple "-eabihf")
    # Both release ABIs use hardware floating point; keep the CPU/FPU minimum
    # consistent with the supported ARMv7 boards rather than the build host.
    set(restunts_armv7_flags "-march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard")
    string(APPEND CMAKE_C_FLAGS_INIT " ${restunts_armv7_flags}")
    string(APPEND CMAKE_CXX_FLAGS_INIT " ${restunts_armv7_flags}")
endif()
set(CMAKE_C_COMPILER_TARGET "${restunts_bsd_triple}")
set(CMAKE_CXX_COMPILER_TARGET "${restunts_bsd_triple}")
set(CMAKE_SYSROOT "${RESTUNTS_BSD_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_PREFIX_PATH /usr/local /usr/pkg /usr/X11R6 /usr/X11R7)
foreach(kind EXE SHARED MODULE)
    set(CMAKE_${kind}_LINKER_FLAGS_INIT "-fuse-ld=${CMAKE_LINKER}")
    if(RESTUNTS_BSD_TARGET STREQUAL "netbsd-armv7")
        # Clang names GNU's NetBSD-specific emulation, which LLD does not
        # implement. ARM ELF plus the release startup objects preserve its ABI.
        string(APPEND CMAKE_${kind}_LINKER_FLAGS_INIT " -Wl,-m,armelf")
    endif()
endforeach()
if(CMAKE_SYSTEM_NAME STREQUAL "NetBSD" AND CMAKE_SYSTEM_VERSION VERSION_LESS 11)
    # Older NetBSD loaders require exactly two PT_LOAD segments in DSOs. LLD
    # must merge read-only/code segments and disable RELRO to avoid an extra load.
    foreach(kind SHARED MODULE)
        string(APPEND CMAKE_${kind}_LINKER_FLAGS_INIT " -Wl,--no-rosegment,-z,norelro")
    endforeach()
endif()
# pkg-config runs on the build host, but must describe only target libraries.
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
# FindPkgConfig otherwise appends unrooted CMAKE_PREFIX_PATH directories.
set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH FALSE)
set(restunts_pkgconfig_dirs)
foreach(prefix usr/local usr/pkg usr/X11R6 usr/X11R7 usr)
    list(APPEND restunts_pkgconfig_dirs
        "${CMAKE_SYSROOT}/${prefix}/lib/pkgconfig"
        "${CMAKE_SYSROOT}/${prefix}/libdata/pkgconfig"
        "${CMAKE_SYSROOT}/${prefix}/share/pkgconfig")
endforeach()
list(JOIN restunts_pkgconfig_dirs ":" restunts_pkgconfig_path)
set(ENV{PKG_CONFIG_LIBDIR} "${restunts_pkgconfig_path}")
