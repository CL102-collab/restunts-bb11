cmake_minimum_required(VERSION 3.25)
project(restunts_wasm_relink LANGUAGES C CXX)
if(NOT EMSCRIPTEN)
    message(FATAL_ERROR "Configure with emcmake cmake; this package contains WebAssembly objects")
endif()
if(NOT CMAKE_C_COMPILER_VERSION VERSION_EQUAL "@CMAKE_C_COMPILER_VERSION@")
    message(WARNING "Compiler differs from the original Clang @CMAKE_C_COMPILER_VERSION@; see nuked-build-info.txt for the matching SDK")
endif()
set(CMAKE_C_STANDARD 99)
set(CMAKE_C_STANDARD_REQUIRED ON)
# Imported archives retain the original build's shared-memory ABI.
set(RESTUNTS_WASM_THREADS @RESTUNTS_WASM_THREADS@)
if(RESTUNTS_WASM_THREADS)
    add_compile_options(-pthread)
endif()
add_subdirectory(nuked-opl2-lite)
add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../mt32emu/rebuild" mt32emu-rebuild)
add_library(restunts_game STATIC IMPORTED)
set_target_properties(restunts_game PROPERTIES
    IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/lib/librestunts_game.a")
add_library(restunts_webm STATIC IMPORTED)
set_target_properties(restunts_webm PROPERTIES
    IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/lib/librestunts_webm.a")
add_library(restunts_sdl STATIC IMPORTED)
set_target_properties(restunts_sdl PROPERTIES
    IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/lib/libSDL3.a")
file(GLOB entry_objects "${CMAKE_CURRENT_SOURCE_DIR}/objects/*.o")
if(NOT entry_objects)
    message(FATAL_ERROR "The relink package is missing its application entry objects")
endif()
add_executable(restunts ${entry_objects})
set_target_properties(restunts PROPERTIES LINKER_LANGUAGE CXX)
target_link_libraries(restunts PRIVATE restunts_game restunts_webm restunts_sdl nuked_opl2 mt32emu m)
include(wasm-link.cmake)
restunts_configure_wasm(restunts "${CMAKE_CURRENT_SOURCE_DIR}/data"
    "${CMAKE_CURRENT_SOURCE_DIR}/shell.html")
if(RESTUNTS_WASM_THREADS)
    include(ExternalProject)
    set(audio_build "${CMAKE_CURRENT_BINARY_DIR}/audio-serial")
    ExternalProject_Add(restunts_audio_serial
        SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/audio"
        BINARY_DIR "${audio_build}"
        CMAKE_ARGS "-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}"
            "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}"
            "-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}"
        BUILD_COMMAND "${CMAKE_COMMAND}" --build <BINARY_DIR> --target restunts_audio_runtime
            --parallel "@RESTUNTS_WASM_AUDIO_BUILD_JOBS@"
        INSTALL_COMMAND "" BUILD_ALWAYS TRUE
        BUILD_BYPRODUCTS "${audio_build}/restunts_audio_runtime.js"
        EXCLUDE_FROM_ALL TRUE)
    set(audio_runtime "${audio_build}/restunts_audio_runtime.js")
    set(audio_runtime_target restunts_audio_serial)
else()
    file(GLOB audio_objects "${CMAKE_CURRENT_SOURCE_DIR}/audio/objects/*.o")
    if(NOT audio_objects)
        message(FATAL_ERROR "The relink package is missing its independent audio objects")
    endif()
    add_executable(restunts_audio_runtime ${audio_objects})
    target_link_libraries(restunts_audio_runtime PRIVATE restunts_game restunts_webm restunts_sdl
        nuked_opl2 mt32emu m)
    restunts_configure_wasm_audio_runtime(restunts_audio_runtime)
    set(audio_runtime "${CMAKE_CURRENT_BINARY_DIR}/restunts_audio_runtime.js")
    set(audio_runtime_target restunts_audio_runtime)
endif()
restunts_embed_wasm_audio(restunts "${audio_runtime}"
    "${CMAKE_CURRENT_SOURCE_DIR}/audio/browser_audio_worker.js"
    "${CMAKE_CURRENT_SOURCE_DIR}/audio/browser_audio_worklet.js"
    "${CMAKE_CURRENT_SOURCE_DIR}/audio/browser_audio.js"
    "${CMAKE_CURRENT_SOURCE_DIR}/audio/generate-audio-sources.py")
add_dependencies(restunts_audio_sources ${audio_runtime_target})
# Reuse the editor from the complete package without duplicating it in the relink kit.
set(restunts_editor_html "${CMAKE_CURRENT_SOURCE_DIR}/../../../tracked.html")
if(EXISTS "${restunts_editor_html}")
    configure_file("${restunts_editor_html}" "${CMAKE_CURRENT_BINARY_DIR}/tracked.html" COPYONLY)
endif()
