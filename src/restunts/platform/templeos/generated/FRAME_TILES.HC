      if((RsFrameDrawTileBackground((&(temple_tile_5439)),tiles,camera,
              TempleCastS8(redraw_transform_flags),TempleCastS16(temple_first_pass_5436),
              TempleCastS16(temple_pass_5438))!=0)) {
