            (&(temple_tile_5433)),tiles,TempleCastS16(temple_tile_index_5435))))) {
        goto temple_next_5434;
      }
      if((RsFrameDrawTileBackground((&(temple_tile_5433)),tiles,camera,
              TempleCastS8(redraw_transform_flags),TempleCastS16(temple_first_pass_5430),
              TempleCastS16(temple_pass_5432))!=0)) {
        return TempleCastS16(1);
      }
      if((temple_pass_5432==FRAME_TILE_GROUND_PASS)) {
        goto temple_next_5434;
      }
      if((RsFrameDrawTileObjects((&(temple_tile_5433)),tiles,camera,cars,
              TempleCastS8(redraw_transform_flags),TempleCastS8(animated_material),
              (&(temple_overlay_needs_depth_sort_5429)))!=0)) {
        return TempleCastS16(1);
      }
    temple_next_5434:;
      temple_tmp_5436=&(temple_tile_index_5435);
      temple_tmp_5437=*temple_tmp_5436;
      *temple_tmp_5436=TempleCastS16((temple_tmp_5437+1));
      temple_tmp_5437;
    }
    temple_tmp_5438=&(temple_pass_5432);
    temple_tmp_5439=*temple_tmp_5438;
    *temple_tmp_5438=TempleCastS16((temple_tmp_5439+1));
    temple_tmp_5439;
  }
  return TempleCastS16(0);
}

legacy_void RsFrameDrawClassic(CFrameTileSelection *tiles,CFrameCamera *camera,
    CFrameCarRender *cars,legacy_s8 buffer_index,legacy_s8 redraw_transform_flags,
    legacy_s8 animated_material)
{
  legacy_s8 noreg temple_initial_brake_paint_5440;
  temple_initial_brake_paint_5440=TempleCastS8(backlights_paint_override);
  (frame_racing_line_enabled=TempleCastU8(1));
  (frame_racing_line_submitted=TempleCastU8(0));
  RsFramePlaceCars(tiles,cars);
  RsFrameDrawTiles(
      tiles,camera,cars,TempleCastS8(redraw_transform_flags),TempleCastS8(animated_material));
  if((RsFrameRetryWithoutRacingLine()!=0)) {
    RsPolyinfoReset();
    (backlights_paint_override=TempleCastS8(temple_initial_brake_paint_5440));
    RsFrameBegin(TempleCastS8(buffer_index));
    RsFrameDrawClouds(camera,TempleCastS8(redraw_transform_flags));
    (cars[PLAYER_CAR_INDEX].explosion_visible=TempleCastS8(0));
    (cars[OPPONENT_CAR_INDEX].explosion_visible=TempleCastS8(0));
    RsFramePlaceCars(tiles,cars);
    RsFrameDrawTiles(
        tiles,camera,cars,TempleCastS8(redraw_transform_flags),TempleCastS8(animated_material));
  }
  (frame_racing_line_enabled=TempleCastU8(1));
}
