      if((RsFrameDrawTileBackground((&(temple_tile_5380)),tiles,camera,
              TempleCastS8(redraw_transform_flags),TempleCastS16(temple_first_pass_5377),
              TempleCastS16(temple_pass_5379))!=0)) {
