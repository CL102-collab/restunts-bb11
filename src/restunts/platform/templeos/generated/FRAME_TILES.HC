            (&(temple_tile_5525)),tiles,TempleCastS16(temple_tile_index_5527))))) {
        goto temple_next_5526;
      }
      if((RsFrameDrawTileBackground((&(temple_tile_5525)),tiles,camera,
              TempleCastS8(redraw_transform_flags),TempleCastS16(temple_first_pass_5522),
              TempleCastS16(temple_pass_5524))!=0)) {
        return TempleCastS16(1);
      }
      if((temple_pass_5524==FRAME_TILE_GROUND_PASS)) {
        goto temple_next_5526;
      }
      if((RsFrameDrawTileObjects((&(temple_tile_5525)),tiles,camera,cars,
              TempleCastS8(redraw_transform_flags),TempleCastS8(animated_material),
              (&(temple_overlay_needs_depth_sort_5521)))!=0)) {
        return TempleCastS16(1);
      }
    temple_next_5526:;
      temple_tmp_5528=&(temple_tile_index_5527);
      temple_tmp_5529=*temple_tmp_5528;
      *temple_tmp_5528=TempleCastS16((temple_tmp_5529+1));
      temple_tmp_5529;
    }
    temple_tmp_5530=&(temple_pass_5524);
    temple_tmp_5531=*temple_tmp_5530;
    *temple_tmp_5530=TempleCastS16((temple_tmp_5531+1));
    temple_tmp_5531;
  }
  return TempleCastS16(0);
}

legacy_void RsFrameDrawClassic(CFrameTileSelection *tiles,CFrameCamera *camera,
    CFrameCarRender *cars,legacy_s8 buffer_index,legacy_s8 redraw_transform_flags,
    legacy_s8 animated_material)
{
  legacy_s8 noreg temple_initial_brake_paint_5532;
  temple_initial_brake_paint_5532=TempleCastS8(backlights_paint_override);
  (frame_racing_line_enabled=TempleCastU8(1));
  (frame_racing_line_submitted=TempleCastU8(0));
  RsFramePlaceCars(tiles,cars);
  RsFrameDrawTiles(
      tiles,camera,cars,TempleCastS8(redraw_transform_flags),TempleCastS8(animated_material));
  if((RsFrameRetryWithoutRacingLine()!=0)) {
    RsPolyinfoReset();
    (backlights_paint_override=TempleCastS8(temple_initial_brake_paint_5532));
    RsFrameBegin(TempleCastS8(buffer_index));
    RsFrameDrawClouds(camera,TempleCastS8(redraw_transform_flags));
    (cars[PLAYER_CAR_INDEX].explosion_visible=TempleCastS8(0));
    (cars[OPPONENT_CAR_INDEX].explosion_visible=TempleCastS8(0));
    RsFramePlaceCars(tiles,cars);
    RsFrameDrawTiles(
        tiles,camera,cars,TempleCastS8(redraw_transform_flags),TempleCastS8(animated_material));
  }
  (frame_racing_line_enabled=TempleCastU8(1));
}
