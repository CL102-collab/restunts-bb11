  if(!temple_tmp_7799) {
    temple_tmp_7799=0;
    if((supersight_probe_frames>=16)) {
      temple_tmp_7799=1;
    }
  }
  if(temple_tmp_7799) {
    (supersight_attempt_hint=TempleCastS16(0));
    (supersight_probe_frames=TempleCastU8(0));
    (supersight_view_valid=TempleCastU8(1));
  }
  temple_tmp_7800=&(supersight_probe_frames);
  temple_tmp_7801=*temple_tmp_7800;
  *temple_tmp_7800=TempleCastU8((temple_tmp_7801+1));
  temple_tmp_7801;
  return TempleCastS16(supersight_attempt_hint);
}

legacy_void RsFrameHiresPrepareTiles(CFrameTileSelection *tiles,CFrameCamera *camera)
{
  if((supersight_enabled!=0)) {
    RsFrameExtendLookahead(tiles,camera);
  }
}
