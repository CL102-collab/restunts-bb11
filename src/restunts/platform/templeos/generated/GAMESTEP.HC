legacy_void RsGamestepUpdateGamestateImpl(
    legacy_s16 caller_si,legacy_s16 update_audio,legacy_s16 store_checkpoints)
{
  legacy_s8 noreg temple_car_input_730;
  legacy_s32 noreg temple_tmp_731;
  legacy_u16 noreg temple_checkpoint_index_732;
  temple_car_input_730=TempleCastS8(replay_input_buffer[TempleCastU16(state.game_frame)]);
  if((TempleCastU32(temple_car_input_730)!=0)) {
    (state.game_inputmode=TempleCastS8(GAME_INPUT_MODE_ACTIVE));
  }
  temple_tmp_731=0;
  if((checkpoint_frame_interval==0)) {
    temple_tmp_731=1;
  }
  if(!temple_tmp_731) {
    temple_tmp_731=0;
    if((TempleCastS32(TempleRemainderS64(
            TempleCastU16(state.game_frame),TempleCastU16(checkpoint_frame_interval)))==0)) {
      temple_tmp_731=1;
    }
  }
  if(temple_tmp_731) {
    RsGetKevinrandomSeed(state.kevinseed);
    temple_checkpoint_index_732=
        TempleCastU16(RsLegacyU16DivOrZero(TempleCastU16(TempleCastU16(state.game_frame)),
            TempleCastU16(TempleCastU16(checkpoint_frame_interval))));
    (caller_si=TempleCastS16(
        RsGamestepLegacyS16FromBits(TempleCastU16(TempleCastU16(temple_checkpoint_index_732)))));
    if((store_checkpoints!=0)) {
      RsInternal2Fmemcpy(
          (&(cvxptr[temple_checkpoint_index_732])),(&(state)),TempleCastU16(sizeof(CGameState)));
    }
  }
  (state.game_frame=TempleCastS16(RsGamestepLegacyS16FromBits(TempleCastU16(TempleCastU16(
      TempleCastU16(TempleCastS32((TempleCastU16(state.game_frame)+TempleCastU16(1)))))))));
  RsGamestepUpdateRaceEndTiming();
  if((state.game_inputmode!=GAME_INPUT_MODE_WAITING)) {
    RsUpdatePlayerTickWithLegacySi(TempleCastS8(temple_car_input_730),TempleCastS16(caller_si));
    if((gameconfig.game_opponenttype!=0)) {
      RsUpdateOpponentTick();
    }
