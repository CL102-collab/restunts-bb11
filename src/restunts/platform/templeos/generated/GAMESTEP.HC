legacy_void RsGamestepUpdateGamestateImpl(
    legacy_s16 caller_si,legacy_s16 update_audio,legacy_s16 store_checkpoints)
{
  legacy_s8 noreg temple_car_input_839;
  legacy_s32 noreg temple_tmp_840;
  legacy_u16 noreg temple_checkpoint_index_841;
  temple_car_input_839=TempleCastS8(replay_input_buffer[TempleCastU16(state.game_frame)]);
  if((TempleCastU32(temple_car_input_839)!=0)) {
    (state.game_inputmode=TempleCastS8(GAME_INPUT_MODE_ACTIVE));
  }
  temple_tmp_840=0;
  if((checkpoint_frame_interval==0)) {
    temple_tmp_840=1;
  }
  if(!temple_tmp_840) {
    temple_tmp_840=0;
    if((TempleCastS32(TempleRemainderS64(
            TempleCastU16(state.game_frame),TempleCastU16(checkpoint_frame_interval)))==0)) {
      temple_tmp_840=1;
    }
  }
  if(temple_tmp_840) {
    RsGetKevinrandomSeed(state.kevinseed);
    temple_checkpoint_index_841=
        TempleCastU16(RsLegacyU16DivOrZero(TempleCastU16(TempleCastU16(state.game_frame)),
            TempleCastU16(TempleCastU16(checkpoint_frame_interval))));
    (caller_si=TempleCastS16(
        RsGamestepLegacyS16FromBits(TempleCastU16(TempleCastU16(temple_checkpoint_index_841)))));
    if((store_checkpoints!=0)) {
      RsInternal2Fmemcpy(
          (&(cvxptr[temple_checkpoint_index_841])),(&(state)),TempleCastU16(sizeof(CGameState)));
    }
  }
  (state.game_frame=TempleCastS16(RsGamestepLegacyS16FromBits(TempleCastU16(TempleCastU16(
      TempleCastU16(TempleCastS32((TempleCastU16(state.game_frame)+TempleCastU16(1)))))))));
  RsGamestepUpdateRaceEndTiming();
  if((state.game_inputmode!=GAME_INPUT_MODE_WAITING)) {
    RsUpdatePlayerTickWithLegacySi(TempleCastS8(temple_car_input_839),TempleCastS16(caller_si));
    if((gameconfig.game_opponenttype!=0)) {
      RsUpdateOpponentTick();
    }
    RsUpdateFollowCameras();
    if((state.game_particles_active!=0)) {
      RsUpdateCrashParticles();
    }
    if((update_audio!=0)) {
      RsAudioCarstate();
    }
  } else {
    if((game_replay_mode==REPLAY_MODE_PAUSED)) {
      if((update_audio!=0)) {
        RsAudioCarstate();
      }
      RsGamestepUpdateRaceStartSequence();
    }
  }
}

