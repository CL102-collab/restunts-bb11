    (temple_car_input_847=TempleCastS8(replay_input_buffer[TempleCastU16(state.game_frame)]));
  }
  if((TempleCastU32(temple_car_input_847)!=0)) {
    (state.game_inputmode=TempleCastS8(GAME_INPUT_MODE_ACTIVE));
  }
  temple_tmp_849=0;
