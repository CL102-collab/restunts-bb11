    temple_tmp_849=1;
  }
  if(temple_tmp_849) {
    temple_tmp_848=0;
    if((checkpoint_frame_interval==0)) {
      temple_tmp_848=1;
    }
    if(!temple_tmp_848) {
      temple_tmp_848=0;
      if((TempleCastS32(TempleRemainderS64(
              TempleCastU16(state.game_frame),TempleCastU16(checkpoint_frame_interval)))==0)) {
        temple_tmp_848=1;
      }
    }
    temple_tmp_849=0;
    if(temple_tmp_848) {
      temple_tmp_849=1;
    }
