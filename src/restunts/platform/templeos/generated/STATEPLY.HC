            carstate,simd,temple_car_pose_6376,TempleCastS16(car_index))) {
        temple_tmp_6377=1;
      }
    }
    if(temple_tmp_6377) {
      return;
    }
  }
  RsCommitWorkingCarPose(carstate);
  RsOwootUpdatePlayer(carstate,TempleCastS16(car_index));
}
