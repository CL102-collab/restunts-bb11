            carstate,simd,temple_car_pose_6481,TempleCastS16(car_index))) {
        temple_tmp_6482=1;
      }
    }
    if(temple_tmp_6482) {
      return;
    }
  }
  RsCommitWorkingCarPose(carstate);
  RsOwootUpdatePlayer(carstate,TempleCastS16(car_index));
}
