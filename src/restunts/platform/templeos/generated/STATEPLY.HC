            carstate,simd,temple_car_pose_6333,TempleCastS16(car_index))) {
        temple_tmp_6334=1;
      }
    }
    if(temple_tmp_6334) {
      return;
    }
  }
  RsCommitWorkingCarPose(carstate);
  RsOwootUpdatePlayer(carstate,TempleCastS16(car_index));
}
