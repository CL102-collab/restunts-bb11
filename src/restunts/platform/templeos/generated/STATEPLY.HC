            carstate,simd,temple_car_pose_6335,TempleCastS16(car_index))) {
        temple_tmp_6336=1;
      }
    }
    if(temple_tmp_6336) {
      return;
    }
  }
  RsCommitWorkingCarPose(carstate);
  RsOwootUpdatePlayer(carstate,TempleCastS16(car_index));
}
