  RsInitializeWorkingCarPose(carstate);
  RsPrepareWheelMotion(carstate,simd,(&(temple_motion_6334)),TempleCastS16(car_index));
  RsResolveWheelContacts(carstate,(&(temple_motion_6334)),TempleCastS16(car_index));
  RsApplyWheelSuspension(carstate,(&(temple_motion_6334)));
  RsDeriveCarPoseFromWheels((&(temple_motion_6334)));
  RsSumFrontAndRearWheelSurfaces(carstate);
  if((state.game_inputmode!=GAME_INPUT_MODE_INTRO)) {
    RsStateplyPlayCarImpactSounds(carstate,TempleCastS16(car_index));
    RsStateplyCheckCarBodyPlanes(carstate,simd,TempleCastS16(car_index));
    RsStateplyUpdateCarSurfaceContact(carstate,TempleCastS16(car_index));
    RsStateplyPrepareCarCollisionPose(temple_car_pose_6335);
    temple_tmp_6336=0;
    if(RsStateplyHandleOtherCarCollision(carstate,simd,other_carstate,other_simd,
          temple_car_pose_6335,TempleCastS16(car_index))) {
      temple_tmp_6336=1;
    }
    if(!temple_tmp_6336) {
      temple_tmp_6336=0;
