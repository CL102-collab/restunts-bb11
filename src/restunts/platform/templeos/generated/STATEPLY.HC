  RsInitializeWorkingCarPose(carstate);
  RsPrepareWheelMotion(carstate,simd,(&(temple_motion_6375)),TempleCastS16(car_index));
  RsResolveWheelContacts(carstate,(&(temple_motion_6375)),TempleCastS16(car_index));
  RsApplyWheelSuspension(carstate,(&(temple_motion_6375)));
  RsDeriveCarPoseFromWheels((&(temple_motion_6375)));
  RsSumFrontAndRearWheelSurfaces(carstate);
  if((state.game_inputmode!=GAME_INPUT_MODE_INTRO)) {
    RsStateplyPlayCarImpactSounds(carstate,TempleCastS16(car_index));
    RsStateplyCheckCarBodyPlanes(carstate,simd,TempleCastS16(car_index));
    RsStateplyUpdateCarSurfaceContact(carstate,TempleCastS16(car_index));
    RsStateplyPrepareCarCollisionPose(temple_car_pose_6376);
    temple_tmp_6377=0;
    if(RsStateplyHandleOtherCarCollision(carstate,simd,other_carstate,other_simd,
          temple_car_pose_6376,TempleCastS16(car_index))) {
      temple_tmp_6377=1;
    }
    if(!temple_tmp_6377) {
      temple_tmp_6377=0;
