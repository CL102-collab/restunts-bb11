        TempleCastS32(TempleRemainderS64(TempleCastU16(state.game_frame),framespersec)));
    if((TempleCastU32((TempleCastU16(1)&31))==0)) {
      temple_tmp_5753=TempleCastU32(TempleCastU16(framespersec));
    } else {
      if((TempleCastU32((TempleCastU16(framespersec)&32768))!=0)) {
        if((TempleCastU32((TempleCastU16(1)&31))>=16)) {
          temple_tmp_5750=TempleCastU32(TempleCastU32(65535));
        } else {
          temple_tmp_5750=TempleCastU32(TempleCastU32(
              (TempleCastU32(TempleCastS32(
                  (TempleCastU16(framespersec)>>TempleCastU32((TempleCastU16(1)&31)))))|
                  TempleCastU16(TempleCastU32((TempleCastU32(65535)
                      <<TempleCastU32((16-TempleCastU32((TempleCastU16(1)&31))))))))));
        }
        temple_tmp_5752=TempleCastU32(temple_tmp_5750);
      } else {
        if((TempleCastU32((TempleCastU16(1)&31))>=16)) {
          temple_tmp_5751=TempleCastU32(0);
        } else {
          temple_tmp_5751=TempleCastU32(TempleCastU32(TempleCastS32(
              (TempleCastU16(framespersec)>>TempleCastU32((TempleCastU16(1)&31))))));
        }
        temple_tmp_5752=TempleCastU32(temple_tmp_5751);
      }
      temple_tmp_5753=TempleCastU32(temple_tmp_5752);
    }
    if((temple_replay_frame_5749>=TempleCastU16(RsFrameOverlayLegacyS16FromBits(TempleCastU16(
                                        TempleCastU16(TempleCastU16(temple_tmp_5753))))))) {
      return (&(rect_ingame_text));
