CRectangle *RsDrawIngameText()
{
  legacy_u16 noreg temple_fps_characters_5613;
  legacy_s16 noreg temple_replay_y_5614;
  legacy_u16 noreg temple_replay_frame_5615;
  legacy_u32 noreg temple_tmp_5616;
  legacy_u32 noreg temple_tmp_5617;
  legacy_u32 noreg temple_tmp_5618;
  legacy_u32 noreg temple_tmp_5619;
  legacy_s32 noreg temple_tmp_5620;
  legacy_s32 noreg temple_tmp_5621;
  MemCpy(&(rect_ingame_text),&(empty_rect),sizeof(CRectangle));
  temple_fps_characters_5613=TempleCastU16(RsFrameOverlayPrepareFpsText());
  if((idle_expired!=0)) {
    RsFrameOverlayDrawCenteredIngameResource("dm1",TempleCastS16(170));
    RsFrameOverlayDrawCenteredIngameResource("dm2",TempleCastS16(182));
    return (&(rect_ingame_text));
  }
  if((game_replay_mode!=REPLAY_MODE_LIVE)) {
    temple_replay_y_5614=TempleCastS16(15);
    if((replay_filename[0]!=0)) {
      (temple_replay_y_5614=TempleCastS16(
          RsFrameOverlayDrawReplayFilename(TempleCastU16(temple_fps_characters_5613))));
    }
    if((game_replay_mode!=REPLAY_MODE_PLAYBACK)) {
      return (&(rect_ingame_text));
    }
    temple_replay_frame_5615=TempleCastU16(
        TempleCastS32(TempleRemainderS64(TempleCastU16(state.game_frame),framespersec)));
    if((TempleCastU32((TempleCastU16(1)&31))==0)) {
      temple_tmp_5619=TempleCastU32(TempleCastU16(framespersec));
    } else {
      if((TempleCastU32((TempleCastU16(framespersec)&32768))!=0)) {
        if((TempleCastU32((TempleCastU16(1)&31))>=16)) {
          temple_tmp_5616=TempleCastU32(TempleCastU32(65535));
        } else {
          temple_tmp_5616=TempleCastU32(TempleCastU32(
              (TempleCastU32(TempleCastS32(
                  (TempleCastU16(framespersec)>>TempleCastU32((TempleCastU16(1)&31)))))|
                  TempleCastU16(TempleCastU32((TempleCastU32(65535)
                      <<TempleCastU32((16-TempleCastU32((TempleCastU16(1)&31))))))))));
        }
        temple_tmp_5618=TempleCastU32(temple_tmp_5616);
      } else {
        if((TempleCastU32((TempleCastU16(1)&31))>=16)) {
          temple_tmp_5617=TempleCastU32(0);
        } else {
          temple_tmp_5617=TempleCastU32(TempleCastU32(TempleCastS32(
              (TempleCastU16(framespersec)>>TempleCastU32((TempleCastU16(1)&31))))));
        }
        temple_tmp_5618=TempleCastU32(temple_tmp_5617);
      }
      temple_tmp_5619=TempleCastU32(temple_tmp_5618);
    }
    if((temple_replay_frame_5615>=TempleCastU16(RsFrameOverlayLegacyS16FromBits(TempleCastU16(
                                        TempleCastU16(TempleCastU16(temple_tmp_5619))))))) {
      return (&(rect_ingame_text));
    }
    RsCopyString((&(res_id_buffer[0])),RsLocateTextRes(gameresptr,"rpl"));
    RsFrameOverlayDrawReplayText((&(res_id_buffer[0])),TempleCastS16(temple_replay_y_5614));
    return (&(rect_ingame_text));
  }
  if((state.game_inputmode==GAME_INPUT_MODE_WAITING)) {
    RsFrameOverlayDrawCenteredIngameResource("pre",TempleCastS16(90));
    return (&(rect_ingame_text));
  }
  if((passed_security==0)) {
    RsFrameOverlayDrawCenteredIngameResource("se1",TempleCastS16(93));
    RsFrameOverlayDrawCenteredIngameResource("se2",TempleCastS16(105));
    return (&(rect_ingame_text));
  }
  temple_tmp_5620=0;
  if((follow_opponent_flag!=0)) {
    temple_tmp_5620=1;
  }
  if(!temple_tmp_5620) {
    temple_tmp_5620=0;
    if((cameramode!=CAMERA_MODE_COCKPIT)) {
      temple_tmp_5620=1;
    }
  }
  temple_tmp_5621=0;
  if(temple_tmp_5620) {
    temple_tmp_5621=1;
  }
  if(!temple_tmp_5621) {
    temple_tmp_5621=0;
    if((state.playerstate.car_crash_bmp_flag!=CRASH_EVENT_NONE)) {
      temple_tmp_5621=1;
    }
  }
  if(temple_tmp_5621) {
    return (&(rect_ingame_text));
  }
  RsFrameOverlayDrawIngameRouteInformation();
  return (&(rect_ingame_text));
}
