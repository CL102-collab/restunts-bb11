    temple_line_limit_5606=TempleCastU16(
        TempleCastU32((TempleCastU32(TempleDivideU64(TempleCastU32(TempleCastS32((312-8))),8))-
            temple_reserved_5603)));
    temple_length_5608=TempleCastU16(0);
    while(1) {
      temple_tmp_5610=0;
      if((temple_length_5608<temple_line_limit_5606)) {
        temple_tmp_5610=1;
      }
      if(temple_tmp_5610) {
