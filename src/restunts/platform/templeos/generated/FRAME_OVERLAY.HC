            1))));
    (temple_overlay_bounds_5511.top=TempleCastS16(3));
    (temple_overlay_bounds_5511.bottom=
            TempleCastS16(TempleCastS32((TempleCastS32((3+font_glyph_height))+1))));
  }
  temple_tmp_5512=0;
