    temple_tmp_5528=0;
    if((cameramode!=CAMERA_MODE_COCKPIT)) {
      temple_tmp_5528=1;
    }
  }
  temple_tmp_5529=0;
  if(temple_tmp_5528) {
    temple_tmp_5529=1;
  }
