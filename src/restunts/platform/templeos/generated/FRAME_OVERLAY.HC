  if((fps_display_enabled!=0)) {
    (temple_overlay_bounds_5511.left=TempleCastS16(8));
    (temple_overlay_bounds_5511.right=TempleCastS16(TempleCastU32(
        (TempleCastU32((TempleCastU32(8)+
