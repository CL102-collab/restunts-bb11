CRectangle *RsFrameOverlayDrawIngameTextContent()
{
  legacy_u16 noreg temple_fps_characters_5875;
  legacy_s16 noreg temple_replay_y_5876;
  legacy_u16 noreg temple_replay_frame_5877;
