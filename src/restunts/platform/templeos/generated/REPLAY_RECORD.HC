          TempleCastU16(TempleCastU16(TempleCastS32((TempleCastU16(temple_steering_angle_1956)+
              TempleCastU16(temple_response_1959)))))))));
      if((temple_adjusted_angle_1963<=temple_target_angle_1944)) {
