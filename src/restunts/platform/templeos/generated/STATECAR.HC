    legacy_s8 input_flags,legacy_s16 car_index,CCarState *carstate,CSimd *simd)
{
  legacy_s16 noreg temple_speed_delta_6664;
  temple_speed_delta_6664=TempleCastS16(RsStatecarLegacyS16FromBits(TempleCastU16(
      TempleCastU16(TempleCastU16(TempleCastS32((TempleCastU16(carstate->car_pseudo_gravity)-
          TempleCastU16(simd->aerorestable[TempleCastS32((carstate->car_rev_speed>>10))]))))))));
  if((TempleCastU16(carstate->car_currpm)>TempleCastU16(simd->max_rpm))) {
    (carstate->car_currpm=TempleCastS16(RsStatecarLegacyS16FromBits(TempleCastU16(TempleCastU16(
        TempleCastU16(TempleCastS32((TempleCastU16(simd->max_rpm)-TempleCastU16(1)))))))));
    (temple_speed_delta_6664=TempleCastS16(
        RsStatecarLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
            (TempleCastU16(temple_speed_delta_6664)-TempleCastU16(simd->braking_eff)))))))));
  } else {
    if((TempleCastU32((TempleCastU32(input_flags)&TempleCastU32((1|2))))==1)) {
      (carstate->car_is_braking=TempleCastS8(CAR_PEDAL_RELEASED));
      (carstate->car_is_accelerating=TempleCastS8(CAR_PEDAL_PRESSED));
      (temple_speed_delta_6664=TempleCastS16(RsStatecarAccelerateCar(
          TempleCastS16(car_index),carstate,simd,TempleCastS16(temple_speed_delta_6664))));
    } else {
      if((TempleCastU32((TempleCastU32(input_flags)&TempleCastU32((1|2))))==2)) {
        (carstate->car_is_accelerating=TempleCastS8(CAR_PEDAL_RELEASED));
        (carstate->car_engine_limiter_timer=TempleCastS8(0));
        (carstate->car_is_braking=TempleCastS8(CAR_PEDAL_PRESSED));
        if((car_index==PLAYER_CAR_INDEX)) {
          (temple_speed_delta_6664=TempleCastS16(RsStatecarLegacyS16FromBits(TempleCastU16(
              TempleCastU16(TempleCastU16(TempleCastS32((TempleCastU16(temple_speed_delta_6664)-
                  TempleCastU16(simd->braking_eff)))))))));
        } else {
          (temple_speed_delta_6664=TempleCastS16(RsStatecarLegacyS16FromBits(TempleCastU16(
              TempleCastU16(TempleCastU16(TempleCastS32((TempleCastU16(temple_speed_delta_6664)-
                  TempleCastU16(
                      RsStatecarLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(
                          TempleCastU32((TempleCastU32(TempleCastU16(simd->braking_eff))*
                              TempleCastU32(TempleCastU16(2)))))))))))))))));
        }
      } else {
        (carstate->car_is_accelerating=TempleCastS8(CAR_PEDAL_RELEASED));
        (carstate->car_is_braking=TempleCastS8(CAR_PEDAL_RELEASED));
      }
    }
  }
  if((framespersec==GAME_FRAME_RATE_LOW)) {
    (temple_speed_delta_6664=TempleCastS16(RsStatecarLegacyS16FromBits(TempleCastU16(
        TempleCastU16(TempleCastU16(TempleCastS32((TempleCastU16(temple_speed_delta_6664)+
            TempleCastU16(temple_speed_delta_6664)))))))));
  }
  return TempleCastS16(temple_speed_delta_6664);
}

legacy_u16 RsStatecarApplySpeedDelta(legacy_u16 updated_speed,legacy_s16 speed_delta)
{
  legacy_s32 noreg temple_tmp_6665;
  if((speed_delta>=0)) {
    if((updated_speed<32768)) {
      (updated_speed=TempleCastU16(TempleCastU16(
          TempleCastS32((TempleCastU16(updated_speed)+TempleCastU16(speed_delta))))));
    } else {
      (updated_speed=TempleCastU16(TempleCastU16(
          TempleCastS32((TempleCastU16(updated_speed)+TempleCastU16(speed_delta))))));
      temple_tmp_6665=0;
      if((updated_speed<32768)) {
        temple_tmp_6665=1;
      }
      if(!temple_tmp_6665) {
        temple_tmp_6665=0;
        if((updated_speed>62720)) {
          temple_tmp_6665=1;
        }
      }
      if(temple_tmp_6665) {
        (updated_speed=TempleCastU16(62720));
      }
    }
  } else {
    if((TempleCastU16(RsStatecarLegacyS16FromBits(TempleCastU16(TempleCastU16(
            TempleCastU16(TempleCastU32((0-TempleCastU16(speed_delta))))))))>updated_speed)) {
      (updated_speed=TempleCastU16(0));
    } else {
      (updated_speed=TempleCastU16(TempleCastU16(
          TempleCastS32((TempleCastU16(updated_speed)+TempleCastU16(speed_delta))))));
    }
  }
  return TempleCastU16(updated_speed);
}

legacy_void RsStatecarSynchronizeWheelSpeed(CCarState *carstate,legacy_u16 updated_speed)
{
  legacy_s16 noreg temple_speed_difference_6666;
  if((carstate->car_sum_surf_rear_wheels==0)) {
    (carstate->car_rev_speed=TempleCastU16(updated_speed));
  } else {
    temple_speed_difference_6666=TempleCastS16(RsAbsoluteWord(TempleCastS16(
        RsStatecarLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
            (TempleCastU16(carstate->car_actual_speed)-TempleCastU16(updated_speed))))))))));
    if((temple_speed_difference_6666>5120)) {
      (carstate->car_rev_speed=TempleCastU16(TempleCastU16(
          TempleCastU32((TempleCastU32(TempleCastU32((TempleCastU32(carstate->car_rev_speed)+
                              TempleCastU32(carstate->car_actual_speed))))>>
              1)))));
      (carstate->car_actual_speed=TempleCastU16(carstate->car_rev_speed));
      (carstate->car_engine_limiter_timer=TempleCastS8(5));
    } else {
      (carstate->car_rev_speed=TempleCastU16(updated_speed));
      (carstate->car_actual_speed=TempleCastU16(updated_speed));
    }
  }
}

legacy_void RsStatecarUpdateEngineLimiter(CCarState *carstate,CSimd *simd)
{
  legacy_s32 noreg temple_tmp_6667;
  temple_tmp_6667=0;
  if((carstate->car_sum_surf_all_wheels!=0)) {
    temple_tmp_6667=1;
  }
  if(temple_tmp_6667) {
    temple_tmp_6667=0;
    if((carstate->car_lastrpm>carstate->car_currpm)) {
      temple_tmp_6667=1;
    }
  }
  if(temple_tmp_6667) {
    if((RsStatecarLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
            (TempleCastU16(carstate->car_lastrpm)-TempleCastU16(carstate->car_currpm)))))))>
          2000)) {
      if((TempleCastS32((simd->idle_torque*carstate->car_gearratioshr8))>12000)) {
        (carstate->car_engine_limiter_timer=TempleCastS8(30));
      }
    } else {
      if((RsStatecarLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
              (TempleCastU16(carstate->car_currpm)-TempleCastU16(carstate->car_lastrpm)))))))>
            2000)) {
        (carstate->car_engine_limiter_timer=TempleCastS8(10));
        (carstate->car_actual_speed=TempleCastU16(TempleCastU16(
            TempleCastS32((TempleCastU16(carstate->car_actual_speed)-TempleCastU16(1280))))));
      }
    }
  }
}

legacy_void RsUpdateCarSpeed(
    legacy_s8 input_flags,legacy_s16 car_index,CCarState *carstate,CSimd *simd)
{
  legacy_s16 noreg temple_speed_delta_6668;
  legacy_u16 noreg temple_updated_speed_6669;
  if((carstate->car_engine_limiter_timer!=0)) {
    (carstate->car_engine_limiter_timer=TempleCastS8(
        RsStatecarLegacyS8FromBits(TempleCastU8(TempleCastU8(TempleCastU8(TempleCastS32(
            (TempleCastU8(carstate->car_engine_limiter_timer)-TempleCastU8(1)))))))));
  }
  (carstate->car_speeddiff=TempleCastS16(RsStatecarLegacyS16FromBits(TempleCastU16(
      TempleCastU16(TempleCastU16(TempleCastS32((TempleCastU16(carstate->car_actual_speed)-
          TempleCastU16(carstate->car_lastspeed)))))))));
  (carstate->car_lastspeed=TempleCastU16(carstate->car_actual_speed));
  (carstate->car_lastrpm=TempleCastS16(carstate->car_currpm));
  RsStatecarRequestGearChange(TempleCastS8(input_flags),carstate,simd);
  RsStatecarUpdateGearKnob(carstate,simd);
  temple_speed_delta_6668=TempleCastS16(RsStatecarPedalSpeedDelta(
      TempleCastS8(input_flags),TempleCastS16(car_index),carstate,simd));
  temple_updated_speed_6669=TempleCastU16(RsStatecarApplySpeedDelta(
      TempleCastU16(carstate->car_rev_speed),TempleCastS16(temple_speed_delta_6668)));
  RsStatecarSynchronizeWheelSpeed(carstate,TempleCastU16(temple_updated_speed_6669));
  (carstate->car_currpm=TempleCastS16(RsUpdateRpmFromSpeed(TempleCastU16(carstate->car_currpm),
      TempleCastU16(carstate->car_rev_speed),TempleCastU16(carstate->car_gearratio),
      TempleCastS16(carstate->car_changing_gear),TempleCastU16(simd->idle_rpm))));
  RsStatecarUpdateEngineLimiter(carstate,simd);
  if((carstate->car_actual_speed>state.game_top_speed)) {
    (state.game_top_speed=TempleCastU16(carstate->car_actual_speed));
  }
}

legacy_void RsUpdateCarSpeedFraction(legacy_s8 input_flags,legacy_s16 car_index,
    CCarState *carstate,CSimd *simd,legacy_u32 fraction20)
{
  legacy_s16 noreg temple_previous_rpm_6670;
  legacy_s16 noreg temple_delta_6671;
  legacy_u32 noreg temple_interval_6672;
  legacy_u32 noreg temple_tmp_6673;
  if((fraction20==TempleCastU32(0))) {
    return;
  }
  temple_previous_rpm_6670=TempleCastS16(carstate->car_currpm);
  temple_delta_6671=TempleCastS16(RsStatecarPedalSpeedDelta(
      TempleCastS8(input_flags),TempleCastS16(car_index),carstate,simd));
  if((framespersec==GAME_FRAME_RATE_LOW)) {
    temple_tmp_6673=TempleCastU32(TempleCastU32(
        TempleDivideU64(TempleCastU32((65536*TempleCastU32(GAME_FRAME_RATE_NORMAL))),
            TempleCastU32(GAME_FRAME_RATE_LOW))));
  } else {
    temple_tmp_6673=TempleCastU32(65536);
  }
  temple_interval_6672=TempleCastU32(temple_tmp_6673);
  (carstate->car_currpm=TempleCastS16(TempleCastS32((temple_previous_rpm_6670+
      TempleCastS32(TempleDivideS64(
          TempleCastS32(
              (TempleCastS32(TempleCastS32((carstate->car_currpm-temple_previous_rpm_6670)))*
                  TempleCastS32(fraction20))),
          TempleCastS32(temple_interval_6672)))))));
  (temple_delta_6671=TempleCastS16(TempleCastS16(TempleCastS32(TempleDivideS64(
      TempleCastS32((TempleCastS32(temple_delta_6671)*TempleCastS32(fraction20))),
      TempleCastS32(temple_interval_6672))))));
  RsStatecarSynchronizeWheelSpeed(carstate,
      TempleCastU16(RsStatecarApplySpeedDelta(
          TempleCastU16(carstate->car_rev_speed),TempleCastS16(temple_delta_6671))));
  (carstate->car_currpm=TempleCastS16(RsUpdateRpmFromSpeed(TempleCastU16(carstate->car_currpm),
      TempleCastU16(carstate->car_rev_speed),TempleCastU16(carstate->car_gearratio),
      TempleCastS16(carstate->car_changing_gear),TempleCastU16(simd->idle_rpm))));
}
