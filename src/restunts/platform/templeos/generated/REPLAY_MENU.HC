    case 7:
      RsUpdateCrashState(TempleCastS16(CRASH_EVENT_EXIT),TempleCastS16(PLAYER_CAR_INDEX));
      (replay_recording_flags=TempleCastS8(0));
      (race_exit_request=TempleCastU8(2));
      break;
  }
  RsCheckInput();
}
