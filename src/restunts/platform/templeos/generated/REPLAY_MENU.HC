    case 2:
      if((RsReplayMenuReplayConfirmRestart()!=0)) {
        RsReplayMenuReplayRestartRecording();
        RsReplayMenuReplayResumeLive();
      }
      break;
    case 3:
      if((RsReplayMenuReplayContinueRecording()!=0)) {
        RsReplayMenuReplayResumeLive();
      }
      break;
    case 4:
      RsReplayMenuReplayLoadRecording();
      break;
    case 5:
      RsReplayMenuReplaySaveRecording();
      break;
    case 6:
      RsReplayMenuReplayDisplayOptions();
      break;
    case 7:
      RsUpdateCrashState(TempleCastS16(CRASH_EVENT_EXIT),TempleCastS16(PLAYER_CAR_INDEX));
      (replay_recording_flags=TempleCastS8(0));
      (race_exit_request=TempleCastU8(2));
      break;
  }
  RsCheckInput();
}
