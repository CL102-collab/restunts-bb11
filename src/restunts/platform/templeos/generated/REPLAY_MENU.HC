        RsReplayMenuReplayRestartRecording();
        RsReplayMenuReplayResumeLive();
      }
      break;
    case 3:
      if((RsReplayMenuReplayContinueRecording()!=0)) {
        RsReplayMenuReplayResumeLive();
      }
      break;
    case 4:
      RsReplayMenuReplayLoadRecording();
      break;
    case 5:
      RsReplayMenuReplaySaveRecording();
      break;
    case 6:
      RsReplayMenuReplayDisplayOptions();
