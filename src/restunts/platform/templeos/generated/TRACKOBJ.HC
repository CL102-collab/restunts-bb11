  (saved->wall_collision_enabled=TempleCastS8(track_wall_collision_enabled));
  (saved->terrain_height=TempleCastS16(terrain_height));
  (saved->element_x=TempleCastS16(elem_x_center));
  (saved->element_z=TempleCastS16(elem_z_center));
  (saved->wall_x=TempleCastS16(wall_start_x));
  (saved->wall_z=TempleCastS16(wall_start_z));
  (saved->wall_orientation=TempleCastS16(wall_orientation));
}

legacy_void RsTrackCollisionRestore(CTrackCollisionSnapshot *saved)
{
