legacy_void RsOpponentStoreRoutePoints(legacy_s16 track_index,CTrackObject *track_object,
    CVector *first_point,CVector *second_point,CVector *output,legacy_u8 has_opponent_path)
{
  legacy_u8 noreg temple_column_6117;
  legacy_u8 noreg temple_row_6118;
  legacy_s32 noreg temple_tmp_6119;
  legacy_s16 noreg temple_base_position_6120;
  legacy_s16 noreg temple_native_flag_6121;
  temple_column_6117=TempleCastU8(TempleCastU8(track_route_columns[track_index]));
  temple_row_6118=TempleCastU8(TempleCastU8(track_route_rows[track_index]));
  if(RsExtendedOpponentPlacePoints(TempleCastS16(track_index),first_point,second_point)) {
    goto store_points;
  }
  temple_tmp_6119=0;
  if((first_point->y!=TempleCastS32((-(1))))) {
    temple_tmp_6119=1;
  }
  if(temple_tmp_6119) {
    temple_tmp_6119=0;
    if((track_terrain_map[TempleCastS32((terrainrows[temple_row_6118]+temple_column_6117))]==
          6)) {
      temple_tmp_6119=1;
    }
  }
  if(temple_tmp_6119) {
    (first_point->y=TempleCastS16(
        RsOpponentLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
            (TempleCastU16(first_point->y)+TempleCastU16(hill_height_consts[1])))))))));
    (second_point->y=TempleCastS16(
        RsOpponentLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
            (TempleCastU16(second_point->y)+TempleCastU16(hill_height_consts[1])))))))));
  }
  temple_base_position_6120=
      TempleCastS16(RsTrackObjectBaseZ(track_object,TempleCastU8(temple_row_6118)));
  (first_point->z=TempleCastS16(
      RsOpponentLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
          (TempleCastU16(first_point->z)+TempleCastU16(temple_base_position_6120)))))))));
  (second_point->z=TempleCastS16(
      RsOpponentLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
          (TempleCastU16(second_point->z)+TempleCastU16(temple_base_position_6120)))))))));
  (temple_base_position_6120=
          TempleCastS16(RsTrackObjectBaseX(track_object,TempleCastU8(temple_column_6117))));
  (first_point->x=TempleCastS16(
      RsOpponentLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
          (TempleCastU16(first_point->x)+TempleCastU16(temple_base_position_6120)))))))));
  (second_point->x=TempleCastS16(
      RsOpponentLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32(
          (TempleCastU16(second_point->x)+TempleCastU16(temple_base_position_6120)))))))));
store_points:;
  (output[TRACK_ROUTE_RESULT_CENTER_INDEX].x=TempleCastS16(
      RsOpponentRouteAverage(TempleCastS16(first_point->x),TempleCastS16(second_point->x))));
  if((first_point->y==TempleCastS32((-(1))))) {
    (output[TRACK_ROUTE_RESULT_CENTER_INDEX].y=TempleCastS16(TempleCastS32((-(1)))));
  } else {
    (output[TRACK_ROUTE_RESULT_CENTER_INDEX].y=TempleCastS16(
        RsOpponentRouteAverage(TempleCastS16(first_point->y),TempleCastS16(second_point->y))));
  }
  (output[TRACK_ROUTE_RESULT_CENTER_INDEX].z=TempleCastS16(
      RsOpponentRouteAverage(TempleCastS16(first_point->z),TempleCastS16(second_point->z))));
  MemCpy(&(output[TRACK_ROUTE_RESULT_FIRST_POINT_INDEX]),&((*(first_point))),sizeof(CVector));
