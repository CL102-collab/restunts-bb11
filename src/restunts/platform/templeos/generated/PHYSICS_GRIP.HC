    }
  }
  if((grip_behavior==GRIP_BEHAVIOR_PLAYER)) {
    RsPhysicsGripGripPlayerResponse(carstate,TempleCastS16(temple_initial_angle_6098),
        TempleCastS16(temple_combined_grip_6101),TempleCastU16(temple_demanded_grip_6100),
        TempleCastU16(temple_speed_shr8_6099));
  }
  RsPhysicsGripGripHeadingOffset(carstate);
  RsPhysicsGripGripSlidingSpeed(carstate);
  (carstate->car_slip_angle=TempleCastS16(0));
}
