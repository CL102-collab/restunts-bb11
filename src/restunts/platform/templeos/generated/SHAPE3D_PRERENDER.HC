legacy_void RsGeneratePolyEdges(legacy_s16 *edges,legacy_u16 *line_setup,legacy_s16 clipping_mode)
{
  legacy_s16 noreg temple_clip_left_3851;
  legacy_s16 noreg temple_clip_right_3852;
  legacy_s16 noreg temple_step_count_3853;
  legacy_s16 noreg temple_row_index_3854;
  temple_clip_left_3851=TempleCastS16(drawing_sprite.sprite_raster_left);
  temple_clip_right_3852=TempleCastS16(drawing_sprite.sprite_raster_right);
  if((clipping_mode!=PRERENDER_EDGE_UNCLIPPED_MODE)) {
    RsShape3dPrerenderGeneratePolyEdgePadding(edges,line_setup,
        TempleCastU16(DRAW_LINE_START_LEFT_CLIP_COUNT_INDEX),TempleCastS16(temple_clip_left_3851),
        TempleCastS16(1));
    RsShape3dPrerenderGeneratePolyEdgePadding(edges,line_setup,
        TempleCastU16(DRAW_LINE_START_RIGHT_CLIP_COUNT_INDEX),
        TempleCastS16(temple_clip_right_3852),TempleCastS16(1));
    RsShape3dPrerenderGeneratePolyEdgePadding(edges,line_setup,
        TempleCastU16(DRAW_LINE_END_LEFT_CLIP_COUNT_INDEX),TempleCastS16(temple_clip_left_3851),
        TempleCastS16(0));
    RsShape3dPrerenderGeneratePolyEdgePadding(edges,line_setup,
        TempleCastU16(DRAW_LINE_END_RIGHT_CLIP_COUNT_INDEX),TempleCastS16(temple_clip_right_3852),
        TempleCastS16(0));
  }
  temple_step_count_3853=TempleCastS16(RsShape3dPrerenderLegacyS16FromBits(
      TempleCastU16(TempleCastU16(line_setup[DRAW_LINE_PIXEL_COUNT_INDEX]))));
  if((temple_step_count_3853<=0)) {
    return;
  }
  temple_row_index_3854=TempleCastS16(RsShape3dPrerenderLegacyS16FromBits(
      TempleCastU16(TempleCastU16(line_setup[DRAW_LINE_START_Y_INDEX]))));
  switch(TempleCastU8(line_setup[DRAW_LINE_MODE_AND_CLIP_INDEX])) {
    case 0:
    case 1:
      return;
    case 2:
      RsShape3dPrerenderGeneratePolyVertical(edges,line_setup,
          TempleCastS16(temple_step_count_3853),TempleCastS16(temple_row_index_3854));
      return;
    case 3:
      RsShape3dPrerenderGeneratePolyDiagonalLeft(edges,line_setup,
          TempleCastS16(temple_step_count_3853),TempleCastS16(temple_row_index_3854));
      return;
    case 4:
      RsShape3dPrerenderGeneratePolyDiagonalRight(edges,line_setup,
          TempleCastS16(temple_step_count_3853),TempleCastS16(temple_row_index_3854));
      return;
    case 5:
    case 6:
      RsShape3dPrerenderGeneratePolyYMajor(edges,line_setup,TempleCastS16(temple_step_count_3853),
          TempleCastS16(temple_row_index_3854));
      return;
    case 7:
      RsShape3dPrerenderGeneratePolyXMajorLeft(edges,line_setup,
          TempleCastS16(temple_step_count_3853),TempleCastS16(temple_row_index_3854));
      return;
    case 8:
      RsShape3dPrerenderGeneratePolyXMajorRight(edges,line_setup,
          TempleCastS16(temple_step_count_3853),TempleCastS16(temple_row_index_3854));
      return;
    case 9:
    default:
      return;
  }
}

legacy_void RsShape3dPrerenderPrerenderExtendEdge(legacy_s16 *left_edges,legacy_s16 *right_edges,
    legacy_s16 index,legacy_s16 value,legacy_s16 to_left)
