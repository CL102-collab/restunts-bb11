    RsShape3dPrerenderGeneratePolyEdgePadding(edges,line_setup,
        TempleCastU16(DRAW_LINE_START_LEFT_CLIP_COUNT_INDEX),TempleCastS16(temple_clip_left_3986),
        TempleCastS16(1));
