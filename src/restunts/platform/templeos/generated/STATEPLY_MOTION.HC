  RsStateplyMotionDeriveCarYaw(temple_wheel_offsets_6539);
  RsMatRotY((&(temple_rotation_6540)),TempleCastS16(car_working_yaw));
  RsStateplyMotionRotateWheelOffsets(temple_wheel_offsets_6539,(&(temple_rotation_6540)));
