  RsStateplyMotionRotateWheelOffsets(temple_wheel_offsets_6625,(&(temple_rotation_6626)));
  RsStateplyMotionDeriveCarPitch(temple_wheel_offsets_6625);
  if((car_working_pitch!=0)) {
