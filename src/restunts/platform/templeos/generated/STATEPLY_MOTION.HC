  if((car_working_pitch!=0)) {
    RsMatRotX((&(temple_rotation_6540)),TempleCastS16(car_working_pitch));
    RsStateplyMotionRotateWheelOffsets(temple_wheel_offsets_6539,(&(temple_rotation_6540)));
  }
