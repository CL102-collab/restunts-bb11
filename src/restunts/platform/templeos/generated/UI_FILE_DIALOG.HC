    (temple_dialog_1637.file_count=TempleCastU8(0));
    temple_found_path_1642=RsFileCombineAndFind(directory,"*",extension);
    if((temple_found_path_1642!=0)) {
      RsUiFileDialogFileDialogCollectNames(
          (&(temple_dialog_1637)),temple_found_path_1642,TempleCastU8(0));
    }
    if((temple_dialog_1637.file_count==0)) {
      if((RsUiFileDialogFileDialogEditDirectory((&(temple_dialog_1637)),directory)==
            KEY_ESCAPE)) {
        (temple_result_1640=TempleCastS8(0));
        break;
      }
      goto temple_next_1641;
    }
    RsUiFileDialogFileDialogSortNames((&(temple_dialog_1637)));
    RsUiFileDialogFileDialogDrawScrollLabels((&(temple_dialog_1637)));
    (temple_result_1640=TempleCastS8(
        RsUiFileDialogFileDialogChoose((&(temple_dialog_1637)),directory,filename)));
    if((temple_dialog_1637.search_again==0)) {
      break;
    }
  temple_next_1641:;
  }
  RsDialogCloseTextInput((&(temple_presentation_1638)));
  (g_is_busy=TempleCastS8(temple_saved_busy_1639));
  return TempleCastS8(temple_result_1640);
}

