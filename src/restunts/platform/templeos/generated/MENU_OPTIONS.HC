      RsShowDialog(TempleCastS16(DIALOG_TYPE_MENU),TempleCastS16(DIALOG_SAVE_BACKGROUND),
          temple_input_text_2612,TempleCastU16(65535),TempleCastU16(65535),
          TempleCastS16(perform_graph_color),0,TempleCastS16(temple_initial_input_2611))))));
  if((temple_selected_2613==OPTION_INPUT_KEYBOARD)) {
    RsSelectKeyboardDriving();
  } else {
    if((temple_selected_2613==OPTION_INPUT_JOYSTICK)) {
      RsCalibrateJoystickDriving();
