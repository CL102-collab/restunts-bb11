  MemSet(&temple_version_text_2402,0,sizeof(temple_version_text_2402));
  MemCpy(temple_version_text_2402,"Version 0000000 (Oct 03 2026)",30);
  temple_i_2404=TempleCastU16(0);
  while(1) {
