    temple_delta_2030=TempleCastS16(RsReplayViewerLegacyS16FromBits(
        TempleCastU16(TempleCastU16(TempleCastU16(RsTimerGetDeltaAlt())))));
    (temple_input_2028=
            TempleCastU16(RsReplayViewerReplayReadControlInput(TempleCastS16(temple_delta_2030))));
    temple_tmp_2031=0;
    if((temple_input_2028!=0)) {
      temple_tmp_2031=1;
    }
    if(temple_tmp_2031) {
      temple_tmp_2031=0;
      if((temple_input_2028!=KEY_ESCAPE)) {
        temple_tmp_2031=1;
      }
    }
    temple_tmp_2032=0;
    if(temple_tmp_2031) {
      temple_tmp_2032=1;
    }
    if(temple_tmp_2032) {
      temple_tmp_2032=0;
      if((TempleCastU8(RsHandleIngameKbShortcuts(TempleCastS16(temple_input_2028)))!=0)) {
        temple_tmp_2032=1;
      }
    }
    if(temple_tmp_2032) {
      return;
    }
    temple_tmp_2033=0;
    if((is_in_replay==0)) {
      temple_tmp_2033=1;
    }
    if(temple_tmp_2033) {
      temple_tmp_2033=0;
      if((temple_input_2028==0)) {
        temple_tmp_2033=1;
      }
    }
    if(temple_tmp_2033) {
      if((replaybar_enabled!=0)) {
        RsReplayViewerReplayControlsDraw(
            TempleCastU16(state.game_frame),TempleCastU16(state.game_frame));
      }
      return;
    }
    RsReplayViewerReplayRefreshPlaybackControls();
    if((RsReplayViewerReplayHandleCameraInput((&(temple_input_2028)))!=0)) {
      return;
    }
    if((RsReplayViewerReplayHandleControlInput(TempleCastU16(temple_input_2028))!=0)) {
      return;
    }
    temple_tmp_2034=0;
    if((is_in_replay!=0)) {
      temple_tmp_2034=1;
    }
    if(temple_tmp_2034) {
      temple_tmp_2034=0;
      if((RsFrameFpsExpireIdle()!=0)) {
        temple_tmp_2034=1;
      }
    }
    if(temple_tmp_2034) {
      return;
    }
    RsReplayViewerReplayControlsDraw(
        TempleCastU16(state.game_frame),TempleCastU16(state.game_frame));
  }
}

legacy_void RsLoopGame(legacy_s16 operation,legacy_s16 recorded_frame,legacy_s16 current_frame)
{
  if((operation==REPLAY_LOOP_LOAD_RESOURCES)) {
    RsLocateManyResources(
        (sdgameresptr)(legacy_s8 *),replay_control_shape_ids,(rplyshapes)(legacy_s8 **));
    RsReplayViewerReplayControlsSelect(TempleCastU8(REPLAY_CONTROL_PAUSE));
    return;
  }
  if((operation==REPLAY_LOOP_DRAW_CONTROLS)) {
    RsReplayViewerReplayControlsDraw(TempleCastU16(recorded_frame),TempleCastU16(current_frame));
    return;
  }
  if((operation==REPLAY_LOOP_SELECT_CONTROL)) {
    RsReplayViewerReplayControlsSelect(TempleCastU8(TempleCastU8(recorded_frame)));
    return;
  }
  if((operation!=REPLAY_LOOP_HANDLE_INPUT)) {
    return;
  }
  RsReplayViewerReplayHandleInput();
}
