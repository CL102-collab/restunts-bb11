  legacy_s32 noreg temple_tmp_1894;
  legacy_s32 noreg temple_tmp_1895;
  legacy_s32 noreg temple_tmp_1896;
  legacy_s32 noreg temple_tmp_1897;
  temple_tmp_1890=0;
  if((RsReplayViewerLegacyS8FromBits(TempleCastU8(TempleCastU8(replay_selected_control)))>
        RsReplayViewerLegacyS8FromBits(
            TempleCastU8(TempleCastU8(game_camera_buttons_count[TempleCastU8(cameramode)]))))) {
    temple_tmp_1890=1;
  }
  if(temple_tmp_1890) {
    temple_tmp_1890=0;
    if((cameramode!=CAMERA_MODE_CUSTOM)) {
      temple_tmp_1890=1;
    }
  }
  if(temple_tmp_1890) {
    (replay_selected_control=TempleCastU8(game_camera_buttons_count[TempleCastU8(cameramode)]));
  }
  RsSpriteSelectScreen();
  if((video_uses_page_flipping!=0)) {
    (dashboard_buffer_index=TempleCastS8(TempleCastS32((frame_buffer_index^1))));
  }
  while(1) {
    if(!(1)) {
      break;
    }
    temple_delta_1893=TempleCastS16(RsReplayViewerLegacyS16FromBits(
        TempleCastU16(TempleCastU16(TempleCastU16(RsTimerGetDeltaAlt())))));
    (temple_input_1891=
            TempleCastU16(RsReplayViewerReplayReadControlInput(TempleCastS16(temple_delta_1893))));
    temple_tmp_1894=0;
    if((temple_input_1891!=0)) {
      temple_tmp_1894=1;
    }
    if(temple_tmp_1894) {
      temple_tmp_1894=0;
      if((temple_input_1891!=KEY_ESCAPE)) {
        temple_tmp_1894=1;
      }
    }
    temple_tmp_1895=0;
    if(temple_tmp_1894) {
      temple_tmp_1895=1;
    }
    if(temple_tmp_1895) {
      temple_tmp_1895=0;
      if((TempleCastU8(RsHandleIngameKbShortcuts(TempleCastS16(temple_input_1891)))!=0)) {
        temple_tmp_1895=1;
      }
    }
    if(temple_tmp_1895) {
      return;
    }
    temple_tmp_1896=0;
    if((is_in_replay==0)) {
      temple_tmp_1896=1;
    }
    if(temple_tmp_1896) {
      temple_tmp_1896=0;
      if((temple_input_1891==0)) {
        temple_tmp_1896=1;
      }
    }
    if(temple_tmp_1896) {
      if((replaybar_enabled!=0)) {
        RsReplayViewerReplayControlsDraw(
            TempleCastU16(state.game_frame),TempleCastU16(state.game_frame));
      }
      return;
    }
    RsReplayViewerReplayRefreshPlaybackControls();
    if((RsReplayViewerReplayHandleCameraInput((&(temple_input_1891)))!=0)) {
      return;
    }
    if((RsReplayViewerReplayHandleControlInput(TempleCastU16(temple_input_1891))!=0)) {
      return;
    }
    temple_tmp_1897=0;
    if((is_in_replay!=0)) {
      temple_tmp_1897=1;
    }
    if(temple_tmp_1897) {
      temple_tmp_1897=0;
      if((RsFrameFpsExpireIdle()!=0)) {
        temple_tmp_1897=1;
      }
    }
    if(temple_tmp_1897) {
      return;
    }
    RsReplayViewerReplayControlsDraw(
        TempleCastU16(state.game_frame),TempleCastU16(state.game_frame));
  }
}

legacy_void RsLoopGame(legacy_s16 operation,legacy_s16 recorded_frame,legacy_s16 current_frame)
{
  if((operation==REPLAY_LOOP_LOAD_RESOURCES)) {
    RsLocateManyResources(
        (sdgameresptr)(legacy_s8 *),replay_control_shape_ids,(rplyshapes)(legacy_s8 **));
    RsReplayViewerReplayControlsSelect(TempleCastU8(REPLAY_CONTROL_PAUSE));
    return;
  }
  if((operation==REPLAY_LOOP_DRAW_CONTROLS)) {
    RsReplayViewerReplayControlsDraw(TempleCastU16(recorded_frame),TempleCastU16(current_frame));
    return;
  }
  if((operation==REPLAY_LOOP_SELECT_CONTROL)) {
    RsReplayViewerReplayControlsSelect(TempleCastU8(TempleCastU8(recorded_frame)));
    return;
  }
  if((operation!=REPLAY_LOOP_HANDLE_INPUT)) {
    return;
  }
  RsReplayViewerReplayHandleInput();
}
