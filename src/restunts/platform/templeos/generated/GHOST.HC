legacy_void RsGhostUpdate(legacy_u32 frame,legacy_u16 live_frame_rate)
{
  legacy_s32 noreg temple_tmp_2172;
  legacy_u32 noreg temple_target_2173;
  legacy_s32 noreg temple_tmp_2174;
  legacy_u32 noreg temple_offset_2175;
  legacy_s32 noreg temple_tmp_2176;
  temple_tmp_2172=0;
  if((!(RsGhostIsActive()))) {
    temple_tmp_2172=1;
  }
  if(!temple_tmp_2172) {
    temple_tmp_2172=0;
    if((live_frame_rate==0)) {
      temple_tmp_2172=1;
    }
  }
  if(temple_tmp_2172) {
    return;
  }
  temple_target_2173=TempleCastU32(TempleCastU32(TempleDivideU64(
      TempleCastU32((TempleCastU32(frame)*rs_ghost_ghost_config.game_framespersec)),
      live_frame_rate)));
  if((temple_target_2173>rs_ghost_ghost_config.game_recordedframes)) {
    (temple_target_2173=TempleCastU32(rs_ghost_ghost_config.game_recordedframes));
  }
  temple_tmp_2174=0;
  if(rs_ghost_ghost_pose_valid) {
    temple_tmp_2174=1;
  }
  if(temple_tmp_2174) {
    temple_tmp_2174=0;
    if((temple_target_2173==rs_ghost_ghost_pose_frame)) {
      temple_tmp_2174=1;
    }
  }
  if(temple_tmp_2174) {
    (rs_ghost_ghost_live_frame=TempleCastU32(frame));
    (rs_ghost_ghost_live_frame_rate=TempleCastU16(live_frame_rate));
    return;
  }
  temple_offset_2175=
      TempleCastU32((RsReplayFileSize(TempleCastU16(rs_ghost_ghost_config.game_recordedframes))+
          (temple_target_2173*sizeof(CGhostPose))));
  temple_tmp_2176=0;
  if((!(RsGhostGhostSeek(
        TempleCastU16(rs_ghost_ghost_file),TempleCastS32(TempleCastS32(temple_offset_2175)))))) {
    temple_tmp_2176=1;
  }
  if(!temple_tmp_2176) {
    temple_tmp_2176=0;
    if((RsDosFileRead(TempleCastU16(rs_ghost_ghost_file),(&(rs_ghost_ghost_pose)),
            TempleCastU16(sizeof(CGhostPose)))!=sizeof(CGhostPose))) {
      temple_tmp_2176=1;
    }
  }
  if(temple_tmp_2176) {
    RsGhostEndRace();
    return;
  }
  (rs_ghost_ghost_pose.car.car_sound_flags=TempleCastS8(0));
  (rs_ghost_ghost_pose_frame=TempleCastU16(TempleCastU16(temple_target_2173)));
  (rs_ghost_ghost_pose_valid=TempleCastS16(1));
  (rs_ghost_ghost_live_frame=TempleCastU32(frame));
  (rs_ghost_ghost_live_frame_rate=TempleCastU16(live_frame_rate));
}
