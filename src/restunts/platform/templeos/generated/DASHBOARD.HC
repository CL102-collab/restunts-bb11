      (update->wheel_state=TempleCastU8(DASHBOARD_WHEEL_STATE_RIGHT));
    }
  }
  temple_tmp_2300=0;
  if((dashboard_wheel_shape_cache[update->buffer_index]!=update->wheel_state)) {
    temple_tmp_2300=1;
  }
  if(!temple_tmp_2300) {
    temple_tmp_2300=0;
    if((full_redraw_frames_remaining!=0)) {
      temple_tmp_2300=1;
    }
  }
  if(temple_tmp_2300) {
    if((video_uses_page_flipping==0)) {
      RsMouseDrawOpaqueCheck();
    }
    (update->steering_dot_cleared=TempleCastU8(
        RsDashboardDashboardClearSteeringDot(TempleCastU16(update->buffer_index))));
    RsShape2dRleCopyPositionClipped(whlshapes[update->wheel_state]);
    (dashboard_wheel_shape_cache[update->buffer_index]=TempleCastU8(update->wheel_state));
    (update->wheel_redrawn=TempleCastU8(1));
  } else {
    (update->wheel_redrawn=TempleCastU8(0));
  }
}

legacy_void RsDashboardDashboardSelectGauges(CDashboardUpdate *update)
{
  if((simd_player.spdcenter.py==TempleCastS32((-(1))))) {
    (update->speed_index=TempleCastU16(0));
    (update->gauge_mode=TempleCastU8(DASHBOARD_GAUGE_HIDDEN));
  } else {
    if((simd_player.spdcenter.py==0)) {
      (update->speed_index=
              TempleCastU16(TempleCastS32((TempleCastU16(state.playerstate.car_rev_speed)>>8))));
      (update->gauge_mode=TempleCastU8(DASHBOARD_GAUGE_DIGITAL));
    } else {
      (update->speed_index=TempleCastU16(
          RsLegacyU16DivOrZero(TempleCastU16(TempleCastU16(state.playerstate.car_rev_speed)),
              TempleCastU16(TempleCastU16(640)))));
      if((TempleCastS16(update->speed_index)>=simd_player.spdnumpoints)) {
        (update->speed_index=
                TempleCastU16(TempleCastU16(TempleCastS32((simd_player.spdnumpoints-1)))));
      }
      (update->gauge_mode=TempleCastU8(DASHBOARD_GAUGE_ANALOG));
    }
  }
  (update->rpm_index=
          TempleCastU16(TempleCastS32((TempleCastU16(state.playerstate.car_currpm)>>7))));
  if((TempleCastS16(update->rpm_index)>=simd_player.revnumpoints)) {
    (update->rpm_index=
            TempleCastU16(TempleCastU16(TempleCastS32((simd_player.revnumpoints-1)))));
  }
}

legacy_void RsDashboardDashboardDrawDigitalSpeed(legacy_u16 speed_index)
{
  legacy_u16 noreg temple_digit_group_2301;
  legacy_u16 *temple_tmp_2302;
  legacy_u16 *temple_tmp_2303;
  legacy_u8 noreg temple_digit_started_2304;
  legacy_u16 noreg temple_digit_2305;
  legacy_s32 noreg temple_tmp_2306;
  legacy_u16 *temple_tmp_2307;
  temple_digit_group_2301=TempleCastU16(0);
  if((speed_index>=200)) {
    (temple_digit_group_2301=TempleCastU16(2));
    temple_tmp_2302=&(speed_index);
    ((*temple_tmp_2302)=TempleCastU16(((*temple_tmp_2302)-200)));
  } else {
    if((speed_index>=100)) {
      (temple_digit_group_2301=TempleCastU16(1));
      temple_tmp_2303=&(speed_index);
      ((*temple_tmp_2303)=TempleCastU16(((*temple_tmp_2303)-100)));
    }
  }
  temple_digit_started_2304=TempleCastU8(0);
  if((temple_digit_group_2301!=0)) {
    RsSpritePutimageOr(digshapes[temple_digit_group_2301],
        TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_HUNDREDS_X])),
        TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_HUNDREDS_Y])));
    (temple_digit_started_2304=TempleCastU8(1));
  }
  temple_digit_2305=TempleCastU16(RsLegacyU16DivOrZero(
      TempleCastU16(TempleCastU16(speed_index)),TempleCastU16(TempleCastU16(10))));
  temple_tmp_2306=0;
  if((temple_digit_2305!=0)) {
    temple_tmp_2306=1;
  }
  if(!temple_tmp_2306) {
    temple_tmp_2306=0;
    if((temple_digit_started_2304!=0)) {
      temple_tmp_2306=1;
    }
  }
  if(temple_tmp_2306) {
    RsSpritePutimageOr(digshapes[temple_digit_2305],
        TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_TENS_X])),
        TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_TENS_Y])));
    temple_tmp_2307=&(speed_index);
    ((*temple_tmp_2307)=
            TempleCastU16(((*temple_tmp_2307)-TempleCastU32((temple_digit_2305*10)))));
  }
  RsSpritePutimageOr(digshapes[speed_index],
      TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_UNITS_X])),
      TempleCastU16(TempleCastU8(simd_player.spdpoints[DASHBOARD_SPEED_UNITS_Y])));
}

legacy_void RsDashboardDashboardDrawWheelMask(legacy_u8 wheel_state)
{
  if((wheel_state==DASHBOARD_WHEEL_STATE_LEFT)) {
    RsShape2dRenderBmpAsMask(whlshapes[DASHBOARD_LEFT_INSTRUMENT_MASK_SHAPE]);
    RsShape2dRleOrFarPointer(
        TempleCastU16(RsDosMemoryPointerOffset(whlshapes[DASHBOARD_LEFT_INSTRUMENT_SOURCE_SHAPE])),
        TempleCastU16(
            RsDosMemoryPointerSegment(whlshapes[DASHBOARD_LEFT_INSTRUMENT_SOURCE_SHAPE])));
  } else {
    if((wheel_state==DASHBOARD_WHEEL_STATE_RIGHT)) {
      RsShape2dRenderBmpAsMask(whlshapes[DASHBOARD_RIGHT_INSTRUMENT_MASK_SHAPE]);
      RsShape2dRleOrFarPointer(TempleCastU16(RsDosMemoryPointerOffset(
                                  whlshapes[DASHBOARD_RIGHT_INSTRUMENT_SOURCE_SHAPE])),
          TempleCastU16(
              RsDosMemoryPointerSegment(whlshapes[DASHBOARD_RIGHT_INSTRUMENT_SOURCE_SHAPE])));
    }
  }
}

legacy_void RsDashboardDashboardUpdateInstruments(CDashboardUpdate *update)
{
  legacy_u16 noreg temple_dot_index_2308;
  legacy_s32 noreg temple_tmp_2309;
  legacy_s32 noreg temple_tmp_2310;
  legacy_s32 noreg temple_tmp_2311;
  legacy_u16 noreg temple_needle_colors_2312;
  legacy_u8 noreg temple_speed_color_2313;
  legacy_u8 noreg temple_rpm_color_2314;
  temple_tmp_2309=0;
  if((update->wheel_redrawn!=0)) {
    temple_tmp_2309=1;
  }
  if(!temple_tmp_2309) {
    temple_tmp_2309=0;
    if((full_redraw_frames_remaining!=0)) {
      temple_tmp_2309=1;
    }
  }
  temple_tmp_2310=0;
  if(temple_tmp_2309) {
    temple_tmp_2310=1;
  }
  if(!temple_tmp_2310) {
    temple_tmp_2310=0;
    if((dashboard_speed_index_cache[update->buffer_index]!=TempleCastS16(update->speed_index))) {
      temple_tmp_2310=1;
    }
  }
  temple_tmp_2311=0;
  if(temple_tmp_2310) {
    temple_tmp_2311=1;
  }
  if(!temple_tmp_2311) {
    temple_tmp_2311=0;
    if((dashboard_rpm_index_cache[update->buffer_index]!=TempleCastS16(update->rpm_index))) {
      temple_tmp_2311=1;
    }
  }
  if(temple_tmp_2311) {
    if((video_uses_page_flipping==0)) {
      RsMouseDrawOpaqueCheck();
    }
    if((RsDashboardDashboardClearSteeringDot(TempleCastU16(update->buffer_index))!=0)) {
      (update->steering_dot_cleared=TempleCastU8(1));
    }
    RsDashboardDashboardSelectPanelTarget(
        dashboard_instrument_sprite,whlshapes[DASHBOARD_INSTRUMENT_PANEL_SHAPE]);
    RsShape2dRleCopy(
        whlshapes[DASHBOARD_INSTRUMENT_PANEL_SHAPE],TempleCastS16(0),TempleCastS16(0));
    (dashboard_speed_index_cache[update->buffer_index]=
            TempleCastS16(TempleCastS16(update->speed_index)));
    (dashboard_rpm_index_cache[update->buffer_index]=
            TempleCastS16(TempleCastS16(update->rpm_index)));
    temple_needle_colors_2312=TempleCastU16(TempleCastU16(simd_player.reserved_handling_words[4]));
    temple_speed_color_2313=TempleCastU8(TempleCastU8(temple_needle_colors_2312));
    temple_rpm_color_2314=
        TempleCastU8(TempleCastU8(TempleCastS32((temple_needle_colors_2312>>8))));
    if((temple_rpm_color_2314==0)) {
      (temple_rpm_color_2314=TempleCastU8(temple_speed_color_2313));
    }
    if((update->gauge_mode==DASHBOARD_GAUGE_DIGITAL)) {
      RsDashboardDashboardDrawDigitalSpeed(TempleCastU16(update->speed_index));
    } else {
      if((update->gauge_mode==DASHBOARD_GAUGE_ANALOG)) {
        (temple_dot_index_2308=TempleCastU16(TempleCastU32((update->speed_index*2))));
        RsPreRenderLine(TempleCastU16(simd_player.spdcenter.px),
            TempleCastU16(simd_player.spdcenter.py),
            TempleCastU16(TempleCastU8(simd_player.spdpoints[temple_dot_index_2308])),
            TempleCastU16(
                TempleCastU8(simd_player.spdpoints[TempleCastU32((temple_dot_index_2308+1))])),
            TempleCastU16(temple_speed_color_2313));
      }
    }
    (temple_dot_index_2308=TempleCastU16(TempleCastU32((update->rpm_index*2))));
    RsPreRenderLine(TempleCastU16(simd_player.revcenter.px),
        TempleCastU16(simd_player.revcenter.py),
        TempleCastU16(TempleCastU8(simd_player.revpoints[temple_dot_index_2308])),
        TempleCastU16(
            TempleCastU8(simd_player.revpoints[TempleCastU32((temple_dot_index_2308+1))])),
        TempleCastU16(temple_rpm_color_2314));
    RsDashboardDashboardDrawWheelMask(TempleCastU8(update->wheel_state));
    if((video_uses_page_flipping!=0)) {
      RsSpriteSelectMcgaBackbuffer();
    } else {
      RsSpriteSelectScreenCompat();
    }
    RsDashboardDashboardCopyPanel(
        dashboard_instrument_sprite,whlshapes[DASHBOARD_INSTRUMENT_PANEL_SHAPE]);
  }
}

legacy_void RsDashboardDashboardUpdateSteeringDot(CDashboardUpdate *update)
{
  legacy_s32 noreg temple_tmp_2315;
  legacy_s32 noreg temple_tmp_2316;
  legacy_u8 *temple_steering_dots_2317;
  legacy_u16 noreg temple_dot_index_2318;
  legacy_s32 noreg temple_tmp_2319;
  legacy_s16 noreg temple_dot_x_2320;
  legacy_s16 noreg temple_dot_y_2321;
  temple_tmp_2315=0;
  if((dashboard_steering_position_cache[update->buffer_index]!=update->steering_position)) {
    temple_tmp_2315=1;
  }
  if(!temple_tmp_2315) {
    temple_tmp_2315=0;
    if((full_redraw_frames_remaining!=0)) {
      temple_tmp_2315=1;
    }
  }
  temple_tmp_2316=0;
  if(temple_tmp_2315) {
    temple_tmp_2316=1;
  }
  if(!temple_tmp_2316) {
    temple_tmp_2316=0;
    if((update->steering_dot_cleared!=0)) {
      temple_tmp_2316=1;
    }
  }
  if(temple_tmp_2316) {
    if((video_uses_page_flipping==0)) {
      RsMouseDrawOpaqueCheck();
    }
    RsDashboardDashboardSetViewport();
    RsDashboardDashboardClearSteeringDot(TempleCastU16(update->buffer_index));
    temple_steering_dots_2317=(simd_player.steeringdots)(legacy_u8 *);
    if((update->steering_position<0)) {
      temple_tmp_2319=TempleCastS32(RsDashboardLegacyS16FromBits(TempleCastU16(TempleCastU16(
          TempleCastU16(TempleCastU32((0-TempleCastU16(update->steering_position))))))));
    } else {
      temple_tmp_2319=TempleCastS32(update->steering_position);
    }
    temple_dot_index_2318=TempleCastU16(TempleCastU32((TempleCastU16(temple_tmp_2319)*2)));
    temple_dot_x_2320=TempleCastS16(temple_steering_dots_2317[temple_dot_index_2318]);
    temple_dot_y_2321=
        TempleCastS16(temple_steering_dots_2317[TempleCastU32((temple_dot_index_2318+1))]);
    if((update->steering_position<0)) {
      (temple_dot_x_2320=TempleCastS16(TempleCastU8(TempleCastS32((temple_dot_x_2320-
          TempleCastU8(TempleCastS32(
              (TempleCastU8(TempleCastS32((temple_dot_x_2320-temple_steering_dots_2317[0])))
                  <<1))))))));
    }
    (dashboard_steering_dot_x_cache[update->buffer_index]=TempleCastS16(
        RsDashboardLegacyS16FromBits(TempleCastU16(TempleCastU16(
            TempleCastS32((TempleCastU16(TempleCastS32((TempleCastU8(temple_dot_x_2320)-
                                RsShape2dGetAnchorX(gnobshapes[DASHBOARD_STEERING_DOT_SHAPE]))))&
                TempleCastU16(video_x_alignment_mask))))))));
    (dashboard_steering_dot_y_cache[update->buffer_index]=TempleCastS16(
        RsDashboardLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32((
            TempleCastU16(TempleCastU8(temple_dot_y_2321))-
            TempleCastU16(RsShape2dGetAnchorY(gnobshapes[DASHBOARD_STEERING_DOT_SHAPE]))))))))));
    RsSpriteClearShapeAlt(gnobshapes[TempleCastS32((DASHBOARD_STEERING_DOT_BUFFER_FIRST_SHAPE+
                              TempleCastU8(frame_buffer_index)))],
        TempleCastS16(dashboard_steering_dot_x_cache[update->buffer_index]),
        TempleCastS16(dashboard_steering_dot_y_cache[update->buffer_index]));
    RsSpriteAndImageAtAnchor(gnobshapes[DASHBOARD_STEERING_DOT_BACKGROUND_SHAPE],
        TempleCastS16(temple_dot_x_2320),TempleCastS16(temple_dot_y_2321));
    RsSpriteOrImageAtAnchor(gnobshapes[DASHBOARD_STEERING_DOT_SHAPE],
        TempleCastS16(temple_dot_x_2320),TempleCastS16(temple_dot_y_2321));
    (dashboard_steering_position_cache[update->buffer_index]=
            TempleCastS16(update->steering_position));
  }
}

legacy_void RsDashboardDashboardUpdate()
{
  CDashboardUpdate temple_update_2322;
  (temple_update_2322.buffer_index=TempleCastU16(TempleCastU8(dashboard_buffer_index)));
  (temple_update_2322.steering_dot_cleared=TempleCastU8(0));
  RsDashboardDashboardUpdateGear(TempleCastU16(temple_update_2322.buffer_index));
  RsDashboardDashboardUpdateWheel((&(temple_update_2322)));
  RsDashboardDashboardSelectGauges((&(temple_update_2322)));
  RsDashboardDashboardUpdateInstruments((&(temple_update_2322)));
  RsDashboardDashboardUpdateSteeringDot((&(temple_update_2322)));
  RsMouseDrawTransparentCheck();
}

legacy_void RsSetupCarShapes(legacy_s16 operation)
{
  switch(operation) {
    case 0:
      RsDashboardDashboardLoad();
      break;
    case 1:
      RsDashboardDashboardRedrawStatic();
      break;
    case 2:
      RsDashboardDashboardUpdate();
      break;
    case 3:
      RsDashboardDashboardUnload();
      break;
  }
}
