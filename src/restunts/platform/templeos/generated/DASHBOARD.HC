        dashboard_instrument_sprite,whlshapes[DASHBOARD_INSTRUMENT_PANEL_SHAPE]);
    RsShape2dRleCopy(
        whlshapes[DASHBOARD_INSTRUMENT_PANEL_SHAPE],TempleCastS16(0),TempleCastS16(0));
    (dashboard_speed_index_cache[update->buffer_index]=
            TempleCastS16(TempleCastS16(update->speed_index)));
    (dashboard_rpm_index_cache[update->buffer_index]=
            TempleCastS16(TempleCastS16(update->rpm_index)));
    temple_needle_colors_2426=TempleCastU16(TempleCastU16(simd_player.reserved_handling_words[4]));
    temple_speed_color_2427=TempleCastU8(TempleCastU8(temple_needle_colors_2426));
    temple_rpm_color_2428=
        TempleCastU8(TempleCastU8(TempleCastS32((temple_needle_colors_2426>>8))));
    if((temple_rpm_color_2428==0)) {
      (temple_rpm_color_2428=TempleCastU8(temple_speed_color_2427));
    }
    if((update->gauge_mode==DASHBOARD_GAUGE_DIGITAL)) {
      RsDashboardDashboardDrawDigitalSpeed(TempleCastU16(update->speed_index));
    } else {
      if((update->gauge_mode==DASHBOARD_GAUGE_ANALOG)) {
        (temple_dot_index_2422=TempleCastU16(TempleCastU32((update->speed_index*2))));
        RsPreRenderLine(TempleCastU16(simd_player.spdcenter.px),
            TempleCastU16(simd_player.spdcenter.py),
            TempleCastU16(TempleCastU8(simd_player.spdpoints[temple_dot_index_2422])),
            TempleCastU16(
                TempleCastU8(simd_player.spdpoints[TempleCastU32((temple_dot_index_2422+1))])),
            TempleCastU16(temple_speed_color_2427));
      }
    }
    (temple_dot_index_2422=TempleCastU16(TempleCastU32((update->rpm_index*2))));
    RsPreRenderLine(TempleCastU16(simd_player.revcenter.px),
        TempleCastU16(simd_player.revcenter.py),
        TempleCastU16(TempleCastU8(simd_player.revpoints[temple_dot_index_2422])),
        TempleCastU16(
            TempleCastU8(simd_player.revpoints[TempleCastU32((temple_dot_index_2422+1))])),
        TempleCastU16(temple_rpm_color_2428));
