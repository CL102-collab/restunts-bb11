legacy_void RsDashboardDashboardUpdate()
{
  CDashboardUpdate temple_update_2623;
  (temple_update_2623.car=(&(state.playerstate)));
  (temple_update_2623.simd=(&(simd_player)));
  (temple_update_2623.buffer_index=TempleCastU16(TempleCastU8(dashboard_buffer_index)));
  (temple_update_2623.steering_dot_cleared=TempleCastU8(0));
  RsDashboardDashboardUpdateGear(
      temple_update_2623.car,TempleCastU16(temple_update_2623.buffer_index));
  RsDashboardDashboardUpdateWheel((&(temple_update_2623)));
  RsDashboardDashboardSelectGauges((&(temple_update_2623)));
  RsDashboardDashboardUpdateInstruments((&(temple_update_2623)));
  RsDashboardDashboardUpdateSteeringDot((&(temple_update_2623)));
  RsMouseDrawTransparentCheck();
}

legacy_void RsSetupCarShapes(legacy_s16 operation)
{
  switch(operation) {
    case 0:
      RsDashboardDashboardLoad(gameconfig.game_playercarid,(&(simd_player)));
      break;
    case 1:
      RsDashboardDashboardRedrawStatic();
      break;
    case 2:
      RsDashboardDashboardUpdate();
      break;
    case 3:
      RsDashboardDashboardUnload();
      break;
  }
}
