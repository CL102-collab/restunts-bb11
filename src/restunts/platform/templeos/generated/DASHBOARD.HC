    (dashboard_speed_index_cache[update->buffer_index]=
            TempleCastS16(TempleCastS16(update->speed_index)));
    (dashboard_rpm_index_cache[update->buffer_index]=
            TempleCastS16(TempleCastS16(update->rpm_index)));
    temple_needle_colors_2283=TempleCastU16(TempleCastU16(simd_player.reserved_handling_words[4]));
    temple_speed_color_2284=TempleCastU8(TempleCastU8(temple_needle_colors_2283));
    temple_rpm_color_2285=
        TempleCastU8(TempleCastU8(TempleCastS32((temple_needle_colors_2283>>8))));
    if((temple_rpm_color_2285==0)) {
      (temple_rpm_color_2285=TempleCastU8(temple_speed_color_2284));
    }
