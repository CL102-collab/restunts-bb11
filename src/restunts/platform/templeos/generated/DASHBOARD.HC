  temple_tmp_2321=0;
  if(temple_tmp_2320) {
    temple_tmp_2321=1;
  }
  if(!temple_tmp_2321) {
    temple_tmp_2321=0;
    if((update->steering_dot_cleared!=0)) {
      temple_tmp_2321=1;
