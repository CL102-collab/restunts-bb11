legacy_void RsDashboardDashboardUpdate()
{
  CDashboardUpdate temple_update_2601;
  (temple_update_2601.buffer_index=TempleCastU16(TempleCastU8(dashboard_buffer_index)));
  (temple_update_2601.steering_dot_cleared=TempleCastU8(0));
  RsDashboardDashboardUpdateGear(TempleCastU16(temple_update_2601.buffer_index));
  RsDashboardDashboardUpdateWheel((&(temple_update_2601)));
  RsDashboardDashboardSelectGauges((&(temple_update_2601)));
  RsDashboardDashboardUpdateInstruments((&(temple_update_2601)));
  RsDashboardDashboardUpdateSteeringDot((&(temple_update_2601)));
  RsMouseDrawTransparentCheck();
}

legacy_void RsSetupCarShapes(legacy_s16 operation)
{
  switch(operation) {
    case 0:
      RsDashboardDashboardLoad();
      break;
    case 1:
      RsDashboardDashboardRedrawStatic();
      break;
    case 2:
      RsDashboardDashboardUpdate();
      break;
    case 3:
      RsDashboardDashboardUnload();
      break;
  }
}
