      temple_tmp_2499=1;
    }
  }
  temple_tmp_2500=0;
  if(temple_tmp_2499) {
    temple_tmp_2500=1;
  }
  if(!temple_tmp_2500) {
    temple_tmp_2500=0;
    if((update->steering_dot_cleared!=0)) {
      temple_tmp_2500=1;
    }
  }
  if(temple_tmp_2500) {
    if((video_uses_page_flipping==0)) {
      RsMouseDrawOpaqueCheck();
    }
    RsDashboardDashboardSetViewport();
    RsDashboardDashboardClearSteeringDot(TempleCastU16(update->buffer_index));
    temple_steering_dots_2501=(simd_player.steeringdots)(legacy_u8 *);
    if((update->steering_position<0)) {
      temple_tmp_2503=TempleCastS32(RsDashboardLegacyS16FromBits(TempleCastU16(TempleCastU16(
          TempleCastU16(TempleCastU32((0-TempleCastU16(update->steering_position))))))));
    } else {
      temple_tmp_2503=TempleCastS32(update->steering_position);
    }
    temple_dot_index_2502=TempleCastU16(TempleCastU32((TempleCastU16(temple_tmp_2503)*2)));
    temple_dot_x_2504=TempleCastS16(temple_steering_dots_2501[temple_dot_index_2502]);
    temple_dot_y_2505=
        TempleCastS16(temple_steering_dots_2501[TempleCastU32((temple_dot_index_2502+1))]);
    if((update->steering_position<0)) {
      (temple_dot_x_2504=TempleCastS16(TempleCastU8(TempleCastS32((temple_dot_x_2504-
          TempleCastU8(TempleCastS32(
              (TempleCastU8(TempleCastS32((temple_dot_x_2504-temple_steering_dots_2501[0])))
                  <<1))))))));
    }
    (dashboard_steering_dot_x_cache[update->buffer_index]=TempleCastS16(
        RsDashboardLegacyS16FromBits(TempleCastU16(TempleCastU16(
            TempleCastS32((TempleCastU16(TempleCastS32((TempleCastU8(temple_dot_x_2504)-
                                RsShape2dGetAnchorX(gnobshapes[DASHBOARD_STEERING_DOT_SHAPE]))))&
                TempleCastU16(video_x_alignment_mask))))))));
    (dashboard_steering_dot_y_cache[update->buffer_index]=TempleCastS16(
        RsDashboardLegacyS16FromBits(TempleCastU16(TempleCastU16(TempleCastU16(TempleCastS32((
            TempleCastU16(TempleCastU8(temple_dot_y_2505))-
            TempleCastU16(RsShape2dGetAnchorY(gnobshapes[DASHBOARD_STEERING_DOT_SHAPE]))))))))));
    RsSpriteClearShapeAlt(gnobshapes[TempleCastS32((DASHBOARD_STEERING_DOT_BUFFER_FIRST_SHAPE+
                              TempleCastU8(frame_buffer_index)))],
        TempleCastS16(dashboard_steering_dot_x_cache[update->buffer_index]),
        TempleCastS16(dashboard_steering_dot_y_cache[update->buffer_index]));
    RsSpriteAndImageAtAnchor(gnobshapes[DASHBOARD_STEERING_DOT_BACKGROUND_SHAPE],
        TempleCastS16(temple_dot_x_2504),TempleCastS16(temple_dot_y_2505));
    RsSpriteOrImageAtAnchor(gnobshapes[DASHBOARD_STEERING_DOT_SHAPE],
        TempleCastS16(temple_dot_x_2504),TempleCastS16(temple_dot_y_2505));
    (dashboard_steering_position_cache[update->buffer_index]=
            TempleCastS16(update->steering_position));
  }
}

legacy_void RsDashboardDashboardUpdate()
{
  CDashboardUpdate temple_update_2506;
  (temple_update_2506.buffer_index=TempleCastU16(TempleCastU8(dashboard_buffer_index)));
  (temple_update_2506.steering_dot_cleared=TempleCastU8(0));
  RsDashboardDashboardUpdateGear(TempleCastU16(temple_update_2506.buffer_index));
  RsDashboardDashboardUpdateWheel((&(temple_update_2506)));
  RsDashboardDashboardSelectGauges((&(temple_update_2506)));
  RsDashboardDashboardUpdateInstruments((&(temple_update_2506)));
  RsDashboardDashboardUpdateSteeringDot((&(temple_update_2506)));
  RsMouseDrawTransparentCheck();
}

legacy_void RsSetupCarShapes(legacy_s16 operation)
{
  switch(operation) {
    case 0:
      RsDashboardDashboardLoad();
      break;
    case 1:
      RsDashboardDashboardRedrawStatic();
      break;
    case 2:
      RsDashboardDashboardUpdate();
      break;
    case 3:
      RsDashboardDashboardUnload();
      break;
  }
}
