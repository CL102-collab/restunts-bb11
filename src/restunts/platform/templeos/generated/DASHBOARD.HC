  temple_tmp_2603=0;
  if(temple_tmp_2602) {
    temple_tmp_2603=1;
  }
  if(!temple_tmp_2603) {
    temple_tmp_2603=0;
    if((dashboard_speed_index_cache[update->buffer_index]!=TempleCastS16(update->speed_index))) {
      temple_tmp_2603=1;
    }
  }
  temple_tmp_2604=0;
  if(temple_tmp_2603) {
    temple_tmp_2604=1;
  }
  if(!temple_tmp_2604) {
    temple_tmp_2604=0;
    if((dashboard_rpm_index_cache[update->buffer_index]!=TempleCastS16(update->rpm_index))) {
      temple_tmp_2604=1;
    }
