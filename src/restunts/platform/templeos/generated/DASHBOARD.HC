    if((temple_rpm_color_2612==0)) {
      (temple_rpm_color_2612=TempleCastU8(temple_speed_color_2611));
    }
    if((update->gauge_mode==DASHBOARD_GAUGE_DIGITAL)) {
      RsDashboardDashboardDrawDigitalSpeed(update->simd,TempleCastU16(update->speed_index));
    } else {
      if((update->gauge_mode==DASHBOARD_GAUGE_ANALOG)) {
        (temple_dot_index_2605=TempleCastU16(TempleCastU32((update->speed_index*2))));
        RsPreRenderLine(TempleCastU16(update->simd->spdcenter.px),
            TempleCastU16(update->simd->spdcenter.py),
            TempleCastU16(TempleCastU8(update->simd->spdpoints[temple_dot_index_2605])),
            TempleCastU16(
