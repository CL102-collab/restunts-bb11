legacy_void RsDashboardDashboardDrawRpm(CSimd *simd,legacy_u16 rpm_index,legacy_u8 color)
{
  legacy_u16 noreg temple_height_2602;
  legacy_u16 noreg temple_filled_2603;
  legacy_u16 noreg temple_dot_index_2604;
  if((rs_dashboard_dashboard_rpm_bar!=0)) {
    temple_height_2602=TempleCastU16(RsShape2dGetHeight(rs_dashboard_dashboard_rpm_bar));
    temple_filled_2603=TempleCastU16(TempleCastU16(TempleCastU32(
        TempleDivideU64(TempleCastU32((TempleCastU32(temple_height_2602)*rpm_index)),
            TempleCastU16(TempleCastS32((simd->revnumpoints-1)))))));
    if((temple_filled_2603!=0)) {
      RsSpriteFillRectClipped(TempleCastS16(RsShape2dGetPosX(rs_dashboard_dashboard_rpm_bar)),
          TempleCastS16(TempleCastS32(
              (TempleCastS32(
                  (RsShape2dGetPosY(rs_dashboard_dashboard_rpm_bar)+temple_height_2602))-
                  temple_filled_2603))),
          TempleCastS16(RsShape2dGetWidth(rs_dashboard_dashboard_rpm_bar)),
          TempleCastS16(temple_filled_2603),TempleCastS16(color));
    }
    return;
  }
  temple_dot_index_2604=TempleCastU16(TempleCastU32((rpm_index*2)));
  RsPreRenderLine(TempleCastU16(simd->revcenter.px),TempleCastU16(simd->revcenter.py),
      TempleCastU16(TempleCastU8(simd->revpoints[temple_dot_index_2604])),
      TempleCastU16(TempleCastU8(simd->revpoints[TempleCastU32((temple_dot_index_2604+1))])),
      TempleCastU16(color));
}

