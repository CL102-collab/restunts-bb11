legacy_void RsDashboardDashboardUpdate()
{
  CDashboardUpdate temple_update_2293;
  (temple_update_2293.buffer_index=TempleCastU16(TempleCastU8(dashboard_buffer_index)));
  (temple_update_2293.steering_dot_cleared=TempleCastU8(0));
  RsDashboardDashboardUpdateGear(TempleCastU16(temple_update_2293.buffer_index));
  RsDashboardDashboardUpdateWheel((&(temple_update_2293)));
  RsDashboardDashboardSelectGauges((&(temple_update_2293)));
  RsDashboardDashboardUpdateInstruments((&(temple_update_2293)));
  RsDashboardDashboardUpdateSteeringDot((&(temple_update_2293)));
  RsMouseDrawTransparentCheck();
}

legacy_void RsSetupCarShapes(legacy_s16 operation)
{
  switch(operation) {
    case 0:
      RsDashboardDashboardLoad();
      break;
    case 1:
      RsDashboardDashboardRedrawStatic();
      break;
    case 2:
      RsDashboardDashboardUpdate();
      break;
    case 3:
      RsDashboardDashboardUnload();
      break;
  }
}
