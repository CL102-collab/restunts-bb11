      RsDashboardDashboardDrawDigitalSpeed(TempleCastU16(update->speed_index));
    } else {
      if((update->gauge_mode==DASHBOARD_GAUGE_ANALOG)) {
        (temple_dot_index_2279=TempleCastU16(TempleCastU32((update->speed_index*2))));
        RsPreRenderLine(TempleCastU16(simd_player.spdcenter.px),
            TempleCastU16(simd_player.spdcenter.py),
            TempleCastU16(TempleCastU8(simd_player.spdpoints[temple_dot_index_2279])),
            TempleCastU16(
                TempleCastU8(simd_player.spdpoints[TempleCastU32((temple_dot_index_2279+1))])),
            TempleCastU16(temple_speed_color_2284));
      }
    }
    (temple_dot_index_2279=TempleCastU16(TempleCastU32((update->rpm_index*2))));
