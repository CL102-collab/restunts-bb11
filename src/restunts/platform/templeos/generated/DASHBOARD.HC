    temple_height_2580=TempleCastU16(RsShape2dGetHeight(rs_dashboard_dashboard_rpm_bar));
    temple_filled_2581=TempleCastU16(TempleCastU16(TempleCastU32(
        TempleDivideU64(TempleCastU32((TempleCastU32(temple_height_2580)*rpm_index)),
            TempleCastU16(TempleCastS32((simd_player.revnumpoints-1)))))));
    if((temple_filled_2581!=0)) {
      RsSpriteFillRectClipped(TempleCastS16(RsShape2dGetPosX(rs_dashboard_dashboard_rpm_bar)),
          TempleCastS16(TempleCastS32(
              (TempleCastS32(
                  (RsShape2dGetPosY(rs_dashboard_dashboard_rpm_bar)+temple_height_2580))-
                  temple_filled_2581))),
          TempleCastS16(RsShape2dGetWidth(rs_dashboard_dashboard_rpm_bar)),
          TempleCastS16(temple_filled_2581),TempleCastS16(color));
    }
    return;
  }
  temple_dot_index_2582=TempleCastU16(TempleCastU32((rpm_index*2)));
  RsPreRenderLine(TempleCastU16(simd_player.revcenter.px),TempleCastU16(simd_player.revcenter.py),
      TempleCastU16(TempleCastU8(simd_player.revpoints[temple_dot_index_2582])),
      TempleCastU16(
          TempleCastU8(simd_player.revpoints[TempleCastU32((temple_dot_index_2582+1))])),
      TempleCastU16(color));
}

