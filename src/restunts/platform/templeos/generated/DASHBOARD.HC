    temple_tmp_2424=1;
  }
  if(!temple_tmp_2424) {
    temple_tmp_2424=0;
    if((dashboard_speed_index_cache[update->buffer_index]!=TempleCastS16(update->speed_index))) {
      temple_tmp_2424=1;
    }
  }
  temple_tmp_2425=0;
  if(temple_tmp_2424) {
    temple_tmp_2425=1;
  }
