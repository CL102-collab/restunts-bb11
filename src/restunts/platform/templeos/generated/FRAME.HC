    RsRectUnion(frame_layer_rects,(&(temple_mask_bounds_5235)),frame_layer_rects);
  }
  if((!(RsFrameSupersightDashboardTop(cliprect)))) {
    RsShape2dRenderBmpAsMask(dasmshapeptr);
    RsShape2dRleOrFarPointer(TempleCastU16(dastbmp_y2),TempleCastU16(dastseg));
  }
}

legacy_void RsFrameDrawElapsedTime()
{
  if((game_replay_mode==REPLAY_MODE_LIVE)) {
    if((frame_state->game_inputmode!=GAME_INPUT_MODE_WAITING)) {
      RsFormatFrameAsString((&(res_id_buffer[0])),
          TempleCastS16(TempleCastS32((elapsed_time1+elapsed_time2))),TempleCastS16(0));
      RsFontSetFontdef2(fontledresptr);
      if((slow_video_mgmt_copy!=0)) {
        RsRectUnion(RsIntroDrawText((&(res_id_buffer[0])),TempleCastS16(140),
                        TempleCastS16(TempleCastS32((roofbmpheight+2))),
                        TempleCastS16(dialog_fnt_colour),TempleCastS16(0)),
            (&(frame_layer_rects[6])),(&(frame_layer_rects[6])));
      } else {
        RsIntroDrawText((&(res_id_buffer[0])),TempleCastS16(140),
            TempleCastS16(TempleCastS32((roofbmpheight+2))),TempleCastS16(dialog_fnt_colour),
            TempleCastS16(0));
      }
      RsFontSetFontdef();
    }
  }
}

legacy_void RsFrameFinish(legacy_s8 buffer_index,CRectangle *cliprect,
    legacy_s16 skybox_requires_full_redraw,legacy_s16 camera_yaw)
{
  legacy_s16 noreg temple_rect_index_5237;
  legacy_s16 *temple_tmp_5238;
  legacy_s16 noreg temple_tmp_5239;
  legacy_s16 noreg temple_rect_index_5241;
  legacy_s16 *temple_tmp_5242;
  legacy_s16 noreg temple_tmp_5243;
  if((slow_video_mgmt_copy!=0)) {
    RsRectUnion(RsDrawIngameText(),frame_layer_rects,frame_layer_rects);
    if((skybox_requires_full_redraw!=0)) {
      MemCpy(&(frame_layer_rects[0]),&((*(cliprect))),sizeof(CRectangle));
      temple_rect_index_5237=TempleCastS16(1);
      while(1) {
        if(!((temple_rect_index_5237<15))) {
          break;
        }
        MemCpy(&(frame_layer_rects[temple_rect_index_5237]),&(empty_rect),sizeof(CRectangle));
        temple_tmp_5238=&(temple_rect_index_5237);
        temple_tmp_5239=*temple_tmp_5238;
        *temple_tmp_5238=TempleCastS16((temple_tmp_5239+1));
        temple_tmp_5239;
      }
    }
    temple_rect_index_5241=TempleCastS16(0);
    while(1) {
      if(!((temple_rect_index_5241<15))) {
        break;
      }
      MemCpy(&(active_frame_rects[temple_rect_index_5241]),
          &(frame_layer_rects[temple_rect_index_5241]),sizeof(CRectangle));
      temple_tmp_5242=&(temple_rect_index_5241);
      temple_tmp_5243=*temple_tmp_5242;
      *temple_tmp_5242=TempleCastS16((temple_tmp_5243+1));
      temple_tmp_5243;
    }
    (frame_buffer_camera_headings[buffer_index]=TempleCastS16(camera_yaw));
    (last_rendered_camera_heading=TempleCastS16(camera_yaw));
  } else {
    RsDrawIngameText();
  }
}

legacy_void RsUpdateFrame(legacy_s8 buffer_index,CRectangle *cliprect)
{
  CFrameCarRender temple_cars_5244[2];
  legacy_s8 noreg temple_redraw_transform_flags_5245;
  CFrameCamera temple_camera_5246;
  legacy_s8 noreg temple_animated_material_5247;
  CFrameTileSelection temple_tiles_5248;
  legacy_s16 noreg temple_skybox_requires_full_redraw_5249;
  RsFrameSupersightBegin();
  (temple_cars_5244[PLAYER_CAR_INDEX].explosion_visible=TempleCastS8(0));
  (temple_cars_5244[OPPONENT_CAR_INDEX].explosion_visible=TempleCastS8(0));
  temple_redraw_transform_flags_5245=TempleCastS8(RsFrameBegin(TempleCastS8(buffer_index)));
  RsFrameSetupCamera((&(temple_camera_5246)));
  temple_animated_material_5247=TempleCastS8(RsFrameAnimatedMaterial());
  (temple_tiles_5248.lookahead=RsFrameSetupProjection((&(temple_camera_5246)),cliprect));
  RsFrameDrawClouds((&(temple_camera_5246)),TempleCastS8(temple_redraw_transform_flags_5245));
  RsFrameSelectTiles((&(temple_tiles_5248)),(&(temple_camera_5246)));
  RsFrameSupersightPrepareGround((&(temple_camera_5246)));
  if((!(RsFrameSupersightDrawScene((&(temple_tiles_5248)),(&(temple_camera_5246)),
        temple_cars_5244,TempleCastS8(buffer_index),
        TempleCastS8(temple_redraw_transform_flags_5245),
        TempleCastS8(temple_animated_material_5247))))) {
    RsFrameDrawClassic((&(temple_tiles_5248)),(&(temple_camera_5246)),temple_cars_5244,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5245),
        TempleCastS8(temple_animated_material_5247));
  }
  temple_skybox_requires_full_redraw_5249=TempleCastS16(RsSkyboxRender(TempleCastS16(buffer_index),
      cliprect,TempleCastS16(temple_camera_5246.skybox_parameter),
      (&(temple_camera_5246.pitch_roll_rotation)),TempleCastS16(temple_camera_5246.roll),
      TempleCastS16(temple_camera_5246.yaw),
      TempleCastS16(RsFrameBackgroundCameraHeight((&(temple_camera_5246))))));
  RsSpriteSetTargetClipBounds(TempleCastU16(0),TempleCastU16(320),TempleCastU16(cliprect->top),
      TempleCastU16(cliprect->bottom));
  RsShape3dRenderQueuedPrimitives();
  RsFrameDrawExplosions(temple_cars_5244,cliprect);
  RsFrameDrawCockpitEffects(cliprect);
  RsFrameDrawDashboardTop(cliprect);
  RsFrameDrawElapsedTime();
  RsFrameFinish(TempleCastS8(buffer_index),cliprect,
      TempleCastS16(temple_skybox_requires_full_redraw_5249),
      TempleCastS16(temple_camera_5246.yaw));
  RsPolyinfoSetExpanded(TempleCastU8(0));
}
