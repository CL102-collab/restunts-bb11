        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5581),
        TempleCastS8(temple_animated_material_5583));
  } else {
    RsFrameFrameDrawClassic((&(temple_tiles_5584)),(&(temple_camera_5582)),temple_cars_5580,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5581),
        TempleCastS8(temple_animated_material_5583));
