    MemCpy(&(temple_offset_vector_4999),&(simd->wheel_coords[temple_wheel_5001]),sizeof(CVector));
    RsMatMulVector(
        (&(temple_offset_vector_4999)),temple_rotation_4995,(&(temple_rotated_vector_4996)));
