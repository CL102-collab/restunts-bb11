legacy_void RsUpdateFrame(legacy_s8 buffer_index,CRectangle *cliprect)
{
  CFrameCarRender temple_cars_5355[2];
  legacy_s8 noreg temple_redraw_transform_flags_5356;
  CFrameCamera temple_camera_5357;
  legacy_s8 noreg temple_animated_material_5358;
  CFrameTileSelection temple_tiles_5359;
  legacy_s16 noreg temple_skybox_requires_full_redraw_5360;
  RsPolyinfoSetSupersight(TempleCastU8(supersight_enabled));
  if((supersight_enabled==0)) {
    RsFrameSupersightReset();
  }
  (temple_cars_5355[PLAYER_CAR_INDEX].explosion_visible=TempleCastS8(0));
  (temple_cars_5355[OPPONENT_CAR_INDEX].explosion_visible=TempleCastS8(0));
  temple_redraw_transform_flags_5356=TempleCastS8(RsFrameFrameBegin(TempleCastS8(buffer_index)));
  RsFrameFrameSetupCamera((&(temple_camera_5357)));
  temple_animated_material_5358=TempleCastS8(RsFrameFrameAnimatedMaterial());
  (temple_tiles_5359.lookahead=RsFrameFrameSetupProjection((&(temple_camera_5357)),cliprect));
  RsFrameFrameDrawClouds((&(temple_camera_5357)),TempleCastS8(temple_redraw_transform_flags_5356));
  RsFrameFrameSelectTiles((&(temple_tiles_5359)),(&(temple_camera_5357)));
  if((supersight_enabled!=0)) {
    RsFrameFrameDrawSupersight((&(temple_tiles_5359)),(&(temple_camera_5357)),temple_cars_5355,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5356),
        TempleCastS8(temple_animated_material_5358));
  } else {
    RsFrameFrameDrawClassic((&(temple_tiles_5359)),(&(temple_camera_5357)),temple_cars_5355,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5356),
        TempleCastS8(temple_animated_material_5358));
  }
  temple_skybox_requires_full_redraw_5360=TempleCastS16(RsSkyboxRender(TempleCastS16(buffer_index),
      cliprect,TempleCastS16(temple_camera_5357.skybox_parameter),
      (&(temple_camera_5357.pitch_roll_rotation)),TempleCastS16(temple_camera_5357.roll),
      TempleCastS16(temple_camera_5357.yaw),TempleCastS16(temple_camera_5357.position.y)));
  RsSpriteSetTargetClipBounds(TempleCastU16(0),TempleCastU16(320),TempleCastU16(cliprect->top),
      TempleCastU16(cliprect->bottom));
  RsShape3dRenderQueuedPrimitives();
  RsFrameFrameDrawExplosions(temple_cars_5355,cliprect);
  RsFrameFrameDrawCockpitEffects(cliprect);
  RsFrameFrameDrawElapsedTime();
  RsFrameFrameFinish(TempleCastS8(buffer_index),cliprect,
      TempleCastS16(temple_skybox_requires_full_redraw_5360),
      TempleCastS16(temple_camera_5357.yaw));
  RsPolyinfoSetSupersight(TempleCastU8(0));
}

