legacy_void RsFrameDrawCockpitEffects(CRectangle *cliprect)
{
  CCarState *temple_viewed_carstate_5230;
  CGhostCameraState *temple_ghost_camera_5231;
  legacy_s16 noreg temple_frame_5232;
  legacy_s16 noreg temple_crash_frame_5233;
  RsSpriteSetTargetClipBounds(TempleCastU16(0),TempleCastU16(320),TempleCastU16(cliprect->top),
      TempleCastU16(cliprect->bottom));
  if((cameramode==CAMERA_MODE_COCKPIT)) {
    temple_viewed_carstate_5230=RsFrameViewedCarState();
    temple_ghost_camera_5231=RsFrameViewedGhostCamera();
    temple_frame_5232=TempleCastS16(frame_state->game_frame);
    temple_crash_frame_5233=TempleCastS16(frame_state->game_p_end_frame);
    if((temple_ghost_camera_5231!=0)) {
      (temple_frame_5232=TempleCastS16(temple_ghost_camera_5231->frame));
      (temple_crash_frame_5233=TempleCastS16(temple_ghost_camera_5231->crash_frame));
    } else {
      if((temple_viewed_carstate_5230==(&(frame_state->opponentstate)))) {
        (temple_crash_frame_5233=TempleCastS16(frame_state->game_o_end_frame));
      }
    }
    if((temple_viewed_carstate_5230->car_crash_bmp_flag==CRASH_EVENT_COLLISION)) {
      if((slow_video_mgmt_copy!=0)) {
        RsRectUnion(
            RsInitCrak(TempleCastS16(TempleCastS32((temple_frame_5232-temple_crash_frame_5233))),
                TempleCastS16(cliprect->top),
                TempleCastS16(TempleCastS32((cliprect->bottom-cliprect->top)))),
            frame_layer_rects,frame_layer_rects);
      } else {
        RsInitCrak(TempleCastS16(TempleCastS32((temple_frame_5232-temple_crash_frame_5233))),
            TempleCastS16(cliprect->top),
            TempleCastS16(TempleCastS32((cliprect->bottom-cliprect->top))));
      }
    } else {
      if((temple_viewed_carstate_5230->car_crash_bmp_flag==CRASH_EVENT_WATER)) {
        if((slow_video_mgmt_copy!=0)) {
          RsRectUnion(RsDoSinking(TempleCastS16(
                                      TempleCastS32((temple_frame_5232-temple_crash_frame_5233))),
                          TempleCastS16(cliprect->top),
                          TempleCastS16(TempleCastS32((cliprect->bottom-cliprect->top)))),
              frame_layer_rects,frame_layer_rects);
        } else {
          RsDoSinking(TempleCastS16(TempleCastS32((temple_frame_5232-temple_crash_frame_5233))),
              TempleCastS16(cliprect->top),
              TempleCastS16(TempleCastS32((cliprect->bottom-cliprect->top))));
        }
      }
    }
  }
}

legacy_void RsFrameDrawDashboardTop(CRectangle *cliprect)
{
  legacy_s32 noreg temple_tmp_5234;
