legacy_void RsUpdateFrame(legacy_s8 buffer_index,CRectangle *cliprect)
{
  CFrameCarRender temple_cars_5576[2];
  legacy_s8 noreg temple_redraw_transform_flags_5577;
  CFrameCamera temple_camera_5578;
  legacy_s8 noreg temple_animated_material_5579;
  CFrameTileSelection temple_tiles_5580;
  legacy_s16 noreg temple_skybox_requires_full_redraw_5581;
  RsPolyinfoSetSupersight(TempleCastU8(supersight_enabled));
  if((supersight_enabled==0)) {
    RsFrameSupersightReset();
  }
  (temple_cars_5576[PLAYER_CAR_INDEX].explosion_visible=TempleCastS8(0));
  (temple_cars_5576[OPPONENT_CAR_INDEX].explosion_visible=TempleCastS8(0));
  temple_redraw_transform_flags_5577=TempleCastS8(RsFrameFrameBegin(TempleCastS8(buffer_index)));
  RsFrameFrameSetupCamera((&(temple_camera_5578)));
  temple_animated_material_5579=TempleCastS8(RsFrameFrameAnimatedMaterial());
  (temple_tiles_5580.lookahead=RsFrameFrameSetupProjection((&(temple_camera_5578)),cliprect));
  RsFrameFrameDrawClouds((&(temple_camera_5578)),TempleCastS8(temple_redraw_transform_flags_5577));
  RsFrameFrameSelectTiles((&(temple_tiles_5580)),(&(temple_camera_5578)));
  if((supersight_enabled!=0)) {
    RsFrameFrameDrawSupersight((&(temple_tiles_5580)),(&(temple_camera_5578)),temple_cars_5576,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5577),
        TempleCastS8(temple_animated_material_5579));
  } else {
    RsFrameFrameDrawClassic((&(temple_tiles_5580)),(&(temple_camera_5578)),temple_cars_5576,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5577),
        TempleCastS8(temple_animated_material_5579));
  }
  temple_skybox_requires_full_redraw_5581=TempleCastS16(RsSkyboxRender(TempleCastS16(buffer_index),
      cliprect,TempleCastS16(temple_camera_5578.skybox_parameter),
      (&(temple_camera_5578.pitch_roll_rotation)),TempleCastS16(temple_camera_5578.roll),
      TempleCastS16(temple_camera_5578.yaw),TempleCastS16(temple_camera_5578.position.y)));
  RsSpriteSetTargetClipBounds(TempleCastU16(0),TempleCastU16(320),TempleCastU16(cliprect->top),
      TempleCastU16(cliprect->bottom));
  RsShape3dRenderQueuedPrimitives();
  RsFrameFrameDrawExplosions(temple_cars_5576,cliprect);
  RsFrameFrameDrawCockpitEffects(cliprect);
  RsFrameFrameDrawElapsedTime();
  RsFrameFrameFinish(TempleCastS8(buffer_index),cliprect,
      TempleCastS16(temple_skybox_requires_full_redraw_5581),
      TempleCastS16(temple_camera_5578.yaw));
  RsPolyinfoSetSupersight(TempleCastU8(0));
}

