legacy_void RsFrameDrawCockpitEffects(CRectangle *cliprect)
{
  CCarState *temple_viewed_carstate_5288;
  CGhostCameraState *temple_ghost_camera_5289;
  legacy_s16 noreg temple_frame_5290;
  legacy_s16 noreg temple_crash_frame_5291;
  RsSpriteSetTargetClipBounds(TempleCastU16(0),TempleCastU16(320),TempleCastU16(cliprect->top),
      TempleCastU16(cliprect->bottom));
  if((cameramode==CAMERA_MODE_COCKPIT)) {
    temple_viewed_carstate_5288=RsFrameViewedCarState();
    temple_ghost_camera_5289=RsFrameViewedGhostCamera();
    temple_frame_5290=TempleCastS16(frame_state->game_frame);
    temple_crash_frame_5291=TempleCastS16(frame_state->game_p_end_frame);
    if((temple_ghost_camera_5289!=0)) {
      (temple_frame_5290=TempleCastS16(temple_ghost_camera_5289->frame));
      (temple_crash_frame_5291=TempleCastS16(temple_ghost_camera_5289->crash_frame));
    } else {
      if((temple_viewed_carstate_5288==(&(frame_state->opponentstate)))) {
        (temple_crash_frame_5291=TempleCastS16(frame_state->game_o_end_frame));
      }
    }
    if((temple_viewed_carstate_5288->car_crash_bmp_flag==CRASH_EVENT_COLLISION)) {
      if((slow_video_mgmt_copy!=0)) {
        RsRectUnion(
            RsInitCrak(TempleCastS16(TempleCastS32((temple_frame_5290-temple_crash_frame_5291))),
                TempleCastS16(cliprect->top),
                TempleCastS16(TempleCastS32((cliprect->bottom-cliprect->top)))),
            frame_layer_rects,frame_layer_rects);
      } else {
        RsInitCrak(TempleCastS16(TempleCastS32((temple_frame_5290-temple_crash_frame_5291))),
            TempleCastS16(cliprect->top),
            TempleCastS16(TempleCastS32((cliprect->bottom-cliprect->top))));
      }
    } else {
      if((temple_viewed_carstate_5288->car_crash_bmp_flag==CRASH_EVENT_WATER)) {
        if((slow_video_mgmt_copy!=0)) {
          RsRectUnion(RsDoSinking(TempleCastS16(
                                      TempleCastS32((temple_frame_5290-temple_crash_frame_5291))),
                          TempleCastS16(cliprect->top),
                          TempleCastS16(TempleCastS32((cliprect->bottom-cliprect->top)))),
              frame_layer_rects,frame_layer_rects);
        } else {
          RsDoSinking(TempleCastS16(TempleCastS32((temple_frame_5290-temple_crash_frame_5291))),
              TempleCastS16(cliprect->top),
              TempleCastS16(TempleCastS32((cliprect->bottom-cliprect->top))));
        }
      }
    }
  }
}

legacy_void RsFrameDrawDashboardTop(CRectangle *cliprect)
{
  legacy_s32 noreg temple_tmp_5292;
  CRectangle temple_mask_bounds_5293;
  temple_tmp_5292=0;
  if((dastbmp_y==0)) {
    temple_tmp_5292=1;
  }
  if(!temple_tmp_5292) {
    temple_tmp_5292=0;
    if((dashboard_visible==0)) {
      temple_tmp_5292=1;
    }
  }
  if(temple_tmp_5292) {
    return;
  }
  if((slow_video_mgmt_copy!=0)) {
    (temple_mask_bounds_5293.left=TempleCastS16(0));
    (temple_mask_bounds_5293.right=TempleCastS16(320));
    (temple_mask_bounds_5293.top=TempleCastS16(dastbmp_y));
    (temple_mask_bounds_5293.bottom=TempleCastS16(dashbmp_y_copy));
    RsRectUnion(frame_layer_rects,(&(temple_mask_bounds_5293)),frame_layer_rects);
  }
  if((!(RsFrameHiresDashboardTop(cliprect)))) {
    RsShape2dRenderBmpAsMask(dasmshapeptr);
    RsShape2dRleOrFarPointer(TempleCastU16(dastbmp_y2),TempleCastU16(dastseg));
  }
}

legacy_void RsFrameDrawElapsedTime()
{
  if((game_replay_mode==REPLAY_MODE_LIVE)) {
    if((frame_state->game_inputmode!=GAME_INPUT_MODE_WAITING)) {
      RsFormatFrameAsString((&(res_id_buffer[0])),
          TempleCastS16(TempleCastS32((elapsed_time1+elapsed_time2))),TempleCastS16(0));
      RsFontSetFontdef2(fontledresptr);
      if((slow_video_mgmt_copy!=0)) {
        RsRectUnion(RsIntroDrawText((&(res_id_buffer[0])),TempleCastS16(140),
                        TempleCastS16(TempleCastS32((roofbmpheight+2))),
                        TempleCastS16(dialog_fnt_colour),TempleCastS16(0)),
            (&(frame_layer_rects[6])),(&(frame_layer_rects[6])));
      } else {
        RsIntroDrawText((&(res_id_buffer[0])),TempleCastS16(140),
            TempleCastS16(TempleCastS32((roofbmpheight+2))),TempleCastS16(dialog_fnt_colour),
            TempleCastS16(0));
      }
      RsFontSetFontdef();
    }
  }
}

legacy_void RsFrameFinish(legacy_s8 buffer_index,CRectangle *cliprect,
    legacy_s16 skybox_requires_full_redraw,legacy_s16 camera_yaw)
{
  legacy_s16 noreg temple_rect_index_5295;
  legacy_s16 *temple_tmp_5296;
  legacy_s16 noreg temple_tmp_5297;
  legacy_s16 noreg temple_rect_index_5299;
  legacy_s16 *temple_tmp_5300;
  legacy_s16 noreg temple_tmp_5301;
  if((slow_video_mgmt_copy!=0)) {
    RsRectUnion(RsDrawIngameText(),frame_layer_rects,frame_layer_rects);
    if((skybox_requires_full_redraw!=0)) {
      MemCpy(&(frame_layer_rects[0]),&((*(cliprect))),sizeof(CRectangle));
      temple_rect_index_5295=TempleCastS16(1);
      while(1) {
        if(!((temple_rect_index_5295<15))) {
          break;
        }
        MemCpy(&(frame_layer_rects[temple_rect_index_5295]),&(empty_rect),sizeof(CRectangle));
        temple_tmp_5296=&(temple_rect_index_5295);
        temple_tmp_5297=*temple_tmp_5296;
        *temple_tmp_5296=TempleCastS16((temple_tmp_5297+1));
        temple_tmp_5297;
      }
    }
    temple_rect_index_5299=TempleCastS16(0);
    while(1) {
      if(!((temple_rect_index_5299<15))) {
        break;
      }
      MemCpy(&(active_frame_rects[temple_rect_index_5299]),
          &(frame_layer_rects[temple_rect_index_5299]),sizeof(CRectangle));
      temple_tmp_5300=&(temple_rect_index_5299);
      temple_tmp_5301=*temple_tmp_5300;
      *temple_tmp_5300=TempleCastS16((temple_tmp_5301+1));
      temple_tmp_5301;
    }
    (frame_buffer_camera_headings[buffer_index]=TempleCastS16(camera_yaw));
    (last_rendered_camera_heading=TempleCastS16(camera_yaw));
  } else {
    RsDrawIngameText();
  }
}

legacy_void RsUpdateFrame(legacy_s8 buffer_index,CRectangle *cliprect)
{
  legacy_u8 noreg temple_expanded_queue_5302;
  CFrameCarRender temple_cars_5303[2];
  legacy_s8 noreg temple_redraw_transform_flags_5304;
  CFrameCamera temple_camera_5305;
  legacy_s8 noreg temple_animated_material_5306;
  CFrameTileSelection temple_tiles_5307;
  legacy_s16 noreg temple_skybox_requires_full_redraw_5308;
  temple_expanded_queue_5302=TempleCastU8(RsFrameHiresEnabled());
  RsPolyinfoSetSupersight(TempleCastU8(temple_expanded_queue_5302));
  RsFrameHiresBegin();
  (temple_cars_5303[PLAYER_CAR_INDEX].explosion_visible=TempleCastS8(0));
  (temple_cars_5303[OPPONENT_CAR_INDEX].explosion_visible=TempleCastS8(0));
  temple_redraw_transform_flags_5304=TempleCastS8(RsFrameBegin(TempleCastS8(buffer_index)));
  RsFrameSetupCamera((&(temple_camera_5305)));
  temple_animated_material_5306=TempleCastS8(RsFrameAnimatedMaterial());
  (temple_tiles_5307.lookahead=RsFrameSetupProjection((&(temple_camera_5305)),cliprect));
  RsFrameDrawClouds((&(temple_camera_5305)),TempleCastS8(temple_redraw_transform_flags_5304));
  RsFrameSelectTiles((&(temple_tiles_5307)),(&(temple_camera_5305)));
  RsFrameHiresPrepareGround((&(temple_camera_5305)));
  if((!(RsFrameHiresDrawScene((&(temple_tiles_5307)),(&(temple_camera_5305)),temple_cars_5303,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5304),
        TempleCastS8(temple_animated_material_5306))))) {
    RsFrameDrawClassic((&(temple_tiles_5307)),(&(temple_camera_5305)),temple_cars_5303,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5304),
        TempleCastS8(temple_animated_material_5306));
  }
  temple_skybox_requires_full_redraw_5308=TempleCastS16(RsSkyboxRender(TempleCastS16(buffer_index),
      cliprect,TempleCastS16(temple_camera_5305.skybox_parameter),
      (&(temple_camera_5305.pitch_roll_rotation)),TempleCastS16(temple_camera_5305.roll),
      TempleCastS16(temple_camera_5305.yaw),
      TempleCastS16(RsFrameBackgroundCameraHeight((&(temple_camera_5305))))));
  RsSpriteSetTargetClipBounds(TempleCastU16(0),TempleCastU16(320),TempleCastU16(cliprect->top),
      TempleCastU16(cliprect->bottom));
  RsShape3dRenderQueuedPrimitives();
  RsFrameDrawExplosions(temple_cars_5303,cliprect);
  RsFrameDrawCockpitEffects(cliprect);
  RsFrameDrawDashboardTop(cliprect);
  RsFrameDrawElapsedTime();
  RsFrameFinish(TempleCastS8(buffer_index),cliprect,
      TempleCastS16(temple_skybox_requires_full_redraw_5308),
      TempleCastS16(temple_camera_5305.yaw));
  RsPolyinfoSetSupersight(TempleCastU8(0));
}
