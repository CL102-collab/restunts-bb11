  if(temple_tmp_5273) {
    return;
  }
  if((slow_video_mgmt_copy!=0)) {
    (temple_mask_bounds_5274.left=TempleCastS16(0));
    (temple_mask_bounds_5274.right=TempleCastS16(320));
    (temple_mask_bounds_5274.top=TempleCastS16(dastbmp_y));
