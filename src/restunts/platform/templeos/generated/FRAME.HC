}

legacy_void RsUpdateFrame(legacy_s8 buffer_index,CRectangle *cliprect)
{
  CFrameCarRender temple_cars_5361[2];
  legacy_s8 noreg temple_redraw_transform_flags_5362;
  CFrameCamera temple_camera_5363;
  legacy_s8 noreg temple_animated_material_5364;
  CFrameTileSelection temple_tiles_5365;
  legacy_s16 noreg temple_skybox_requires_full_redraw_5366;
  RsPolyinfoSetSupersight(TempleCastU8(supersight_enabled));
  if((supersight_enabled==0)) {
    RsFrameSupersightReset();
  }
  (temple_cars_5361[PLAYER_CAR_INDEX].explosion_visible=TempleCastS8(0));
  (temple_cars_5361[OPPONENT_CAR_INDEX].explosion_visible=TempleCastS8(0));
  temple_redraw_transform_flags_5362=TempleCastS8(RsFrameFrameBegin(TempleCastS8(buffer_index)));
  RsFrameFrameSetupCamera((&(temple_camera_5363)));
  temple_animated_material_5364=TempleCastS8(RsFrameFrameAnimatedMaterial());
  (temple_tiles_5365.lookahead=RsFrameFrameSetupProjection((&(temple_camera_5363)),cliprect));
  RsFrameFrameDrawClouds((&(temple_camera_5363)),TempleCastS8(temple_redraw_transform_flags_5362));
  RsFrameFrameSelectTiles((&(temple_tiles_5365)),(&(temple_camera_5363)));
  if((supersight_enabled!=0)) {
    RsFrameFrameDrawSupersight((&(temple_tiles_5365)),(&(temple_camera_5363)),temple_cars_5361,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5362),
        TempleCastS8(temple_animated_material_5364));
  } else {
    RsFrameFrameDrawClassic((&(temple_tiles_5365)),(&(temple_camera_5363)),temple_cars_5361,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5362),
        TempleCastS8(temple_animated_material_5364));
  }
  temple_skybox_requires_full_redraw_5366=TempleCastS16(RsSkyboxRender(TempleCastS16(buffer_index),
      cliprect,TempleCastS16(temple_camera_5363.skybox_parameter),
      (&(temple_camera_5363.pitch_roll_rotation)),TempleCastS16(temple_camera_5363.roll),
      TempleCastS16(temple_camera_5363.yaw),TempleCastS16(temple_camera_5363.position.y)));
  RsSpriteSetTargetClipBounds(TempleCastU16(0),TempleCastU16(320),TempleCastU16(cliprect->top),
      TempleCastU16(cliprect->bottom));
  RsShape3dRenderQueuedPrimitives();
  RsFrameFrameDrawExplosions(temple_cars_5361,cliprect);
  RsFrameFrameDrawCockpitEffects(cliprect);
  RsFrameFrameDrawElapsedTime();
  RsFrameFrameFinish(TempleCastS8(buffer_index),cliprect,
      TempleCastS16(temple_skybox_requires_full_redraw_5366),
      TempleCastS16(temple_camera_5363.yaw));
  RsPolyinfoSetSupersight(TempleCastU8(0));
}

