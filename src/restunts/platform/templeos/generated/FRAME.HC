  }
  if(temple_tmp_5234) {
    return;
  }
  if((slow_video_mgmt_copy!=0)) {
    (temple_mask_bounds_5235.left=TempleCastS16(0));
    (temple_mask_bounds_5235.right=TempleCastS16(320));
    (temple_mask_bounds_5235.top=TempleCastS16(dastbmp_y));
