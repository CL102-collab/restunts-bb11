  (temple_tiles_5334.lookahead=RsFrameFrameSetupProjection((&(temple_camera_5332)),cliprect));
  RsFrameFrameDrawClouds((&(temple_camera_5332)),TempleCastS8(temple_redraw_transform_flags_5331));
  RsFrameFrameSelectTiles((&(temple_tiles_5334)),(&(temple_camera_5332)));
