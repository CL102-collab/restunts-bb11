        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5331),
        TempleCastS8(temple_animated_material_5333));
  } else {
    RsFrameFrameDrawClassic((&(temple_tiles_5334)),(&(temple_camera_5332)),temple_cars_5330,
        TempleCastS8(buffer_index),TempleCastS8(temple_redraw_transform_flags_5331),
        TempleCastS8(temple_animated_material_5333));
