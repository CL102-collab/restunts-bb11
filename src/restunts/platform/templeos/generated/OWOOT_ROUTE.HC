    temple_tmp_7450=&(temple_bit_7444);
    temple_tmp_7451=*temple_tmp_7450;
    *temple_tmp_7450=TempleCastU16((temple_tmp_7451+1));
    temple_tmp_7451;
  }
  return TempleCastS16(temple_fraction_7442);
}

