        (TempleCastU32(TempleCastU16(vec->y))*TempleCastU16(projection_focal_length_y)))));
    (temple_comp_518=TempleCastS16(TempleCastS16(TempleCastU32((temple_proj_519>>15)))));
    if((vec->z>temple_comp_518)) {
