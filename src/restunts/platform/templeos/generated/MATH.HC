  if((vec->x<0)) {
    (temple_proj_479=TempleCastU32(
        TempleCastU32((TempleCastU32(RsMathProjectionMagnitude(TempleCastS16(vec->x)))*
            TempleCastU16(projection_focal_length_x)))));
