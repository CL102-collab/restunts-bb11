CMatrix *RsMatRotZxy(legacy_s16 z,legacy_s16 x,legacy_s16 y,legacy_s16 rotation_order)
{
  RsMatRotZ((&(rs_math_math_mat_z_rot)),TempleCastS16(z));
  RsMatRotX((&(rs_math_math_mat_x_rot)),TempleCastS16(x));
  (rs_math_math_mat_y_rot_angle=TempleCastU16(y));
  RsMatRotY((&(rs_math_math_mat_y_rot)),TempleCastS16(y));
  if((TempleCastU32((TempleCastU32(rotation_order)&1))==
        TempleCastU32(MATRIX_ROTATION_ORDER_YXZ))) {
    RsMatMultiply(
        (&(rs_math_math_mat_y_rot)),(&(rs_math_math_mat_x_rot)),(&(rs_math_math_mat_rot_temp)));
    RsMatMultiply(
        (&(rs_math_math_mat_rot_temp)),(&(rs_math_math_mat_z_rot)),(&(rs_math_math_mat_x_rot)));
    return (&(rs_math_math_mat_x_rot));
  } else {
    RsMatMultiply(
        (&(rs_math_math_mat_z_rot)),(&(rs_math_math_mat_x_rot)),(&(rs_math_math_mat_rot_temp)));
    RsMatMultiply(
        (&(rs_math_math_mat_rot_temp)),(&(rs_math_math_mat_y_rot)),(&(rs_math_math_mat_z_rot)));
    return (&(rs_math_math_mat_z_rot));
  }
}

