        (TempleCastU32(TempleCastU16(vec->y))*TempleCastU16(projection_focal_length_y)))));
    (temple_comp_478=TempleCastS16(TempleCastS16(TempleCastU32((temple_proj_479>>15)))));
    if((vec->z>temple_comp_478)) {
